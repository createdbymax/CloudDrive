+// sameFilesystem compares identity, never the mutable contents of a filesystem.
+func sameFilesystem(a, b billy.Filesystem) bool {
+	return reflect.TypeOf(a) == reflect.TypeOf(b) && reflect.TypeOf(a) != nil && reflect.TypeOf(a).Comparable() && a == b
+}
+
+// RenameHandles preserves object identities and rebases cached descendant paths.
+// Handles for replaced destination objects become stale rather than aliasing the source.
+func (c *CachingHandler) RenameHandles(f billy.Filesystem, oldPath, newPath []string) error {
+	c.stateMu.Lock()
+	defer c.stateMu.Unlock()
+	if f.Join(oldPath...) == f.Join(newPath...) {
+		return nil
+	}
+	keys := c.activeHandles.Keys()
+	for _, id := range keys {
+		e, ok := c.activeHandles.Peek(id)
+		if !ok || !sameFilesystem(e.f, f) {
+			continue
+		}
+		if hasPrefix(e.p, newPath) && !hasPrefix(e.p, oldPath) {
+			c.evictReverseCache(f.Join(e.p...), id)
+			c.activeHandles.Remove(id)
+		}
+	}
+	for _, id := range keys {
+		e, ok := c.activeHandles.Peek(id)
+		if !ok || !sameFilesystem(e.f, f) || !hasPrefix(e.p, oldPath) {
+			continue
+		}
+		c.evictReverseCache(f.Join(e.p...), id)
+		p := append(append([]string{}, newPath...), e.p[len(oldPath):]...)
+		c.activeHandles.Add(id, entry{e.f, p})
+		c.appendReverseHandle(f.Join(p...), id)
+	}
+	c.activeVerifiers.Purge()
+	return nil
+}
