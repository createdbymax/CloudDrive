+package helpers
+
+import (
+	"bytes"
+	"github.com/go-git/go-billy/v5"
+	"github.com/go-git/go-billy/v5/memfs"
+	"sync"
+	"testing"
+)
+
+type renameHandler interface {
+	RenameHandles(billy.Filesystem, []string, []string) error
+}
+
+func TestRenameHandles(t *testing.T) {
+	f := memfs.New()
+	c := NewCachingHandler(nil, 100).(*CachingHandler)
+	source := c.ToHandle(f, []string{"Album"})
+	child := c.ToHandle(f, []string{"Album", "Sub", "Résumé.wav"})
+	sibling := c.ToHandle(f, []string{"Album2", "keep.wav"})
+	overwritten := c.ToHandle(f, []string{"Destination", "Album"})
+	unrelatedFS := memfs.New()
+	other := c.ToHandle(unrelatedFS, []string{"Album", "keep"})
+	h, ok := any(c).(renameHandler)
+	if !ok {
+		t.Fatal("handler cannot preserve handles across rename")
+	}
+	if err := h.RenameHandles(f, []string{"Album"}, []string{"Destination", "Album"}); err != nil {
+		t.Fatal(err)
+	}
+	check := func(handle []byte, want string) {
+		t.Helper()
+		_, p, err := c.FromHandle(handle)
+		if err != nil || f.Join(p...) != want {
+			t.Fatalf("got %v %v, want %s", p, err, want)
+		}
+	}
+	check(source, "Destination/Album")
+	check(child, "Destination/Album/Sub/Résumé.wav")
+	check(sibling, "Album2/keep.wav")
+	check(other, "Album/keep")
+	if _, _, err := c.FromHandle(overwritten); err == nil {
+		t.Fatal("replacement target handle was rebound to another object")
+	}
+	if !bytes.Equal(child, c.ToHandle(f, []string{"Destination", "Album", "Sub", "Résumé.wav"})) {
+		t.Fatal("lookup changed object identity")
+	}
+	if err := h.RenameHandles(f, []string{"Destination", "Album"}, []string{"Destination", "Album"}); err != nil {
+		t.Fatal(err)
+	}
+	check(child, "Destination/Album/Sub/Résumé.wav")
+}
+
+func TestRenameHandlesConcurrent(t *testing.T) {
+	f := memfs.New()
+	c := NewCachingHandler(nil, 64).(*CachingHandler)
+	h, ok := any(c).(renameHandler)
+	if !ok {
+		t.Fatal("rename hook missing")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 200; j++ {
+				b := c.ToHandle(f, []string{"A", "child"})
+				c.FromHandle(b)
+				h.RenameHandles(f, []string{"A"}, []string{"B"})
+				h.RenameHandles(f, []string{"B"}, []string{"A"})
+				c.InvalidateHandle(f, b)
+			}
+		}()
+	}
+	wg.Wait()
+}
