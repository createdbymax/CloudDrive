+package nfs
+
+import (
+	"errors"
+	"github.com/go-git/go-billy/v5"
+	"github.com/go-git/go-billy/v5/memfs"
+	"math"
+	"os"
+	"sync"
+	"testing"
+)
+
+type truncateLeaseFS struct {
+	billy.Filesystem
+	gate   sync.RWMutex
+	closes int
+	opens  int
+}
+type truncateLeaseFile struct {
+	billy.File
+	owner  *truncateLeaseFS
+	closed bool
+}
+
+func (f *truncateLeaseFS) OpenFile(name string, flags int, perm os.FileMode) (billy.File, error) {
+	f.gate.RLock()
+	fp, err := f.Filesystem.OpenFile(name, flags&^os.O_EXCL, perm)
+	if err != nil {
+		f.gate.RUnlock()
+		return nil, err
+	}
+	f.opens++
+	return &truncateLeaseFile{File: fp, owner: f}, nil
+}
+func (f *truncateLeaseFile) Truncate(size int64) error {
+	return errors.New("injected truncate failure")
+}
+func (f *truncateLeaseFile) Close() error {
+	if !f.closed {
+		f.closed = true
+		f.owner.closes++
+		defer f.owner.gate.RUnlock()
+		return f.File.Close()
+	}
+	return nil
+}
+func TestSetattrFailureReleasesMutationLease(t *testing.T) {
+	for _, size := range []uint64{2, math.MaxUint64} {
+		f := &truncateLeaseFS{Filesystem: memfs.New()}
+		fp, err := f.Filesystem.Create("source")
+		if err != nil {
+			t.Fatal(err)
+		}
+		fp.Close()
+		attrs := SetFileAttributes{SetSize: &size}
+		if err = attrs.Apply(nil, f, "source"); err == nil {
+			t.Fatal("expected SETATTR failure")
+		}
+		if f.opens != 1 {
+			t.Fatalf("fixture failed to open truncation handle: %d opens", f.opens)
+		}
+		if f.closes != 1 {
+			t.Fatalf("SETATTR leaked mutation handle: %d closes", f.closes)
+		}
+		if !f.gate.TryLock() {
+			t.Fatal("subsequent rename would deadlock")
+		}
+		err = f.Filesystem.Rename("source", "destination")
+		f.gate.Unlock()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+}
