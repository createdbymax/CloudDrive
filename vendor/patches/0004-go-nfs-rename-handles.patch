+
+type busyMetadataFS struct{ billy.Filesystem }
+
+func (f busyMetadataFS) Lstat(name string) (os.FileInfo, error) {
+	if name == "busy" {
+		return nil, syscall.EBUSY
+	}
+	return f.Filesystem.Lstat(name)
+}
+
+type busyMetadataHandler struct {
+	Handler
+	fs   billy.Filesystem
+	path []string
+}
+
+func (h busyMetadataHandler) FromHandle([]byte) (billy.Filesystem, []string, error) {
+	return h.fs, h.path, nil
+}
+func TestBusyMetadataIsRetryable(t *testing.T) {
+	f := busyMetadataFS{memfs.New()}
+	for _, parent := range []string{"", "busy"} {
+		b := bytes.NewBuffer(nil)
+		if err := xdr.Write(b, DirOpArg{Handle: []byte("root"), Filename: []byte("busy")}); err != nil {
+			t.Fatal(err)
+		}
+		p := []string{}
+		if parent != "" {
+			p = []string{parent}
+		}
+		err := onLookup(context.Background(), &response{req: &request{Body: b}}, busyMetadataHandler{fs: f, path: p})
+		var status *NFSStatusError
+		if !errors.As(err, &status) || status.NFSStatus != NFSStatusJukebox || !errors.Is(err, syscall.EBUSY) {
+			t.Fatalf("LOOKUP must retry, got %v", err)
+		}
+	}
+	b := bytes.NewBuffer(nil)
+	if err := xdr.Write(b, []byte("handle")); err != nil {
+		t.Fatal(err)
+	}
+	err := onGetAttr(context.Background(), &response{req: &request{Body: b}}, busyMetadataHandler{fs: f, path: []string{"busy"}})
+	var status *NFSStatusError
+	if !errors.As(err, &status) || status.NFSStatus != NFSStatusJukebox {
+		t.Fatalf("GETATTR must retry, got %v", err)
+	}
+}
+
+type failedMetadataFS struct{ billy.Filesystem }
+
+func (f failedMetadataFS) Lstat(name string) (os.FileInfo, error) {
+	if name == "failed" {
+		return nil, syscall.EIO
+	}
+	return f.Filesystem.Lstat(name)
+}
+func (f failedMetadataFS) ReadDir(name string) ([]os.FileInfo, error) {
+	if name == "failed" {
+		return nil, syscall.EIO
+	}
+	return f.Filesystem.ReadDir(name)
+}
+
+func TestBusyMetadataRecoveryFailureIsTerminalIO(t *testing.T) {
+	f := failedMetadataFS{memfs.New()}
+	check := func(operation string, err error) {
+		t.Helper()
+		var status *NFSStatusError
+		if !errors.As(err, &status) || status.NFSStatus != NFSStatusIO || !errors.Is(err, syscall.EIO) {
+			t.Fatalf("%s must report terminal IO instead of retrying or missing path: %v", operation, err)
+		}
+	}
+	for _, parent := range []string{"", "failed"} {
+		body := bytes.NewBuffer(nil)
+		if err := xdr.Write(body, DirOpArg{Handle: []byte("root"), Filename: []byte("failed")}); err != nil {
+			t.Fatal(err)
+		}
+		var path []string
+		if parent != "" {
+			path = []string{parent}
+		}
+		check("LOOKUP", onLookup(context.Background(), &response{req: &request{Body: body}}, busyMetadataHandler{fs: f, path: path}))
+	}
+	body := bytes.NewBuffer(nil)
+	if err := xdr.Write(body, []byte("handle")); err != nil {
+		t.Fatal(err)
+	}
+	handler := busyMetadataHandler{fs: f, path: []string{"failed"}}
+	check("GETATTR", onGetAttr(context.Background(), &response{req: &request{Body: body}}, handler))
+	_, _, err := getDirListingWithVerifier(handler, []byte("handle"), 0)
+	check("READDIR", err)
+}
