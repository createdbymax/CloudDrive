+func TestNativeMoveReportsTerminalMetadataErrorBeforeFreshAttempt(t *testing.T) {
+	ctx := context.Background()
+	backend, err := fs.NewFs(ctx, ":memory:native-errors-"+rand.Text())
+	require.NoError(t, err)
+	movePut(t, backend, "a", "alpha")
+	remote := &nativeFailMetadataFS{Fs: backend}
+	remote.fail.Store(true)
+	opt := vfscommon.Opt
+	opt.MoveJournal = filepath.Join(t.TempDir(), "moves")
+	v := New(ctx, remote, &opt)
+	defer v.Shutdown()
+	require.ErrorIs(t, v.RenameNativeRequest("a", "b", "first-xid"), syscall.EBUSY)
+	require.ErrorIs(t, nativeWait(t, v), errNativeMetadata)
+	requests := remote.calls.Load()
+	require.Greater(t, requests, int32(0))
+	// The very next retry returns a terminal error without launching more I/O,
+	// even though Finder changed its transaction ID and the server is still down.
+	require.ErrorIs(t, v.RenameNativeRequest("a", "b", "retry-xid"), errNativeMetadata)
+	require.Equal(t, requests, remote.calls.Load())
+	require.Equal(t, false, v.MoveStatus()["active"])
+	require.Equal(t, false, v.MoveStatus()["needsRecovery"])
+	// A fresh user attempt can succeed after repair, without a mutation epoch bump.
+	remote.fail.Store(false)
+	require.ErrorIs(t, v.RenameNativeRequest("a", "b", "new-attempt"), syscall.EBUSY)
+	require.NoError(t, nativeWait(t, v))
+	require.NoError(t, v.RenameNativeRequest("a", "b", "new-attempt-retry"))
+	moveExists(t, backend, "a", false)
+	moveExists(t, backend, "b", true)
+}
