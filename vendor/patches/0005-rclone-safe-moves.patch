+package vfs
+
+import (
+	"errors"
+	"strings"
+	"syscall"
+)
+
+type nativeMove struct {
+	source, destination string
+	requestID           string
+	pathValid           bool
+	errorDelivered      bool
+	done                bool
+	err                 error
+	epoch               uint64
+}
+
+const nativeMoveHistoryLimit = 256
+
+// RenameNative is the path-based API. A mutation epoch prevents a completed
+// result from acknowledging a newly created object at the same source path.
+func (vfs *VFS) RenameNative(source, destination string) error {
+	return vfs.RenameNativeRequest(source, destination, "")
+}
+
+// RenameNativeRequest lets a protocol retransmission retain its original result
+// even when subsequent, unrelated moves have replaced the active job.
+func (vfs *VFS) RenameNativeRequest(source, destination, requestID string) error {
+	if vfs.Opt.MoveJournal == "" {
+		return vfs.Rename(source, destination)
+	}
+	source = strings.Trim(source, "/")
+	destination = strings.Trim(destination, "/")
+	if !movePath(source) || !movePath(destination) {
+		return syscall.EINVAL
+	}
+	m := &vfs.safeMoves
+	m.mu.Lock()
+	vfs.loadMove()
+	for i := len(m.nativeHistory) - 1; i >= 0; i-- {
+		job := m.nativeHistory[i]
+		if job.source == source && job.destination == destination &&
+			((requestID != "" && job.requestID == requestID) ||
+				(job.pathValid && (requestID != "" || job.epoch == m.epoch))) {
+			m.replayed = true
+			m.mu.Unlock()
+			return nil
+		}
+	}
+	if job := m.native; job != nil {
+		if !job.done {
+			m.mu.Unlock()
+			return syscall.EBUSY
+		}
+		if job.source == source && job.destination == destination && job.err != nil {
+			// Finder may change XID when retrying JUKEBOX. Deliver this job's
+			// terminal error before treating a later call as a fresh attempt.
+			// Retained journal failures remain blocked until explicit recovery.
+			if m.pending || !job.errorDelivered {
+				job.errorDelivered = true
+				err := job.err
+				if errors.Is(err, syscall.EBUSY) {
+					err = syscall.EIO // a finished job must leave the JUKEBOX retry loop
+				}
+				m.mu.Unlock()
+				return err
+			}
+		}
+	}
+	if m.loadError != nil || m.pending || m.active {
+		m.mu.Unlock()
+		return syscall.EIO
+	}
+	// A new rename may recreate a previous source.
+	// Retain RPC-specific results, but expire ambiguous path-only outcomes.
+	for i := range m.nativeHistory {
+		old := &m.nativeHistory[i]
+		if moveUnder(source, old.source) || moveUnder(old.source, source) ||
+			moveUnder(destination, old.source) || moveUnder(old.source, destination) {
+			old.pathValid = false
+		}
+	}
+	job := &nativeMove{source: source, destination: destination, requestID: requestID}
+	m.native = job
+	m.phase = "preparing"
+	m.completed = 0
+	m.total = 0
+	m.problem = ""
+	m.mu.Unlock()
+	go func() {
+		err := vfs.Rename(source, destination)
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		job.done = true
+		job.err = err
+		job.epoch = m.epoch
+		if err != nil && !m.pending {
+			m.phase = "failed"
+			if m.problem == "" {
+				m.problem = "Move could not finish. Check storage access and try again."
+			}
+			if err == syscall.EBUSY {
+				m.problem = "Close open files or wait for uploads to finish, then try the move again."
+			}
+		}
+		if err == nil {
+			m.rememberNativeMove(job)
+		}
+	}()
+	return syscall.EBUSY
+}
+
+// rememberNativeMove is called with m.mu held after durable completion.
+func (m *safeMoveState) rememberNativeMove(job *nativeMove) {
+	job.pathValid = true
+	m.nativeHistory = append(m.nativeHistory, *job)
+	if len(m.nativeHistory) > nativeMoveHistoryLimit {
+		copy(m.nativeHistory, m.nativeHistory[len(m.nativeHistory)-nativeMoveHistoryLimit:])
+		m.nativeHistory = m.nativeHistory[:nativeMoveHistoryLimit]
+	}
+}
+
+// NotifyMoveCreation invalidates path-based completion replay before a native
+// mutation can recreate a moved source. Call under the mutation lease. Protocol
+// transaction-specific results remain available for actual retransmissions.
+func (vfs *VFS) NotifyMoveCreation(name string) {
+	name = strings.Trim(name, "/")
+	m := &vfs.safeMoves
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for i := range m.nativeHistory {
+		job := &m.nativeHistory[i]
+		if moveUnder(name, job.source) || moveUnder(job.source, name) {
+			job.pathValid = false
+		}
+	}
+}
+
+// CheckMovePath keeps affected native objects retryable without stalling unrelated browsing.
+func (vfs *VFS) CheckMovePath(name string) error {
+	name = strings.Trim(name, "/")
+	m := &vfs.safeMoves
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	vfs.loadMove()
+	if m.loadError != nil {
+		return syscall.EIO
+	}
+	if j := m.native; j != nil && !j.done {
+		if moveUnder(name, j.source) || moveUnder(name, j.destination) {
+			return syscall.EBUSY
+		}
+	}
+	if m.pending && m.journal != nil {
+		if moveUnder(name, m.journal.Source) || moveUnder(name, m.journal.Destination) {
+			if m.active {
+				return syscall.EBUSY
+			}
+			// No background job can resolve this state until explicit Resume.
+			// Return a terminal error so Finder does not retry JUKEBOX forever.
+			return syscall.EIO
+		}
+	}
+	return nil
+}
+
+// beginMoveCommit excludes native handle resolution only for the in-memory commit.
+// The move gate protects commitRelease until endMoveCommit.
+func (vfs *VFS) beginMoveCommit() {
+	m := &vfs.safeMoves
+	if m.commitRelease == nil && m.namespaceLock != nil {
+		m.commitRelease = m.namespaceLock()
+	}
+}
+func (vfs *VFS) endMoveCommit() {
+	m := &vfs.safeMoves
+	if m.commitRelease != nil {
+		release := m.commitRelease
+		m.commitRelease = nil
+		release()
+	}
+}
