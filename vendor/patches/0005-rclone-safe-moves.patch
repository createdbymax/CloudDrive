+package vfs
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"golang.org/x/sync/errgroup"
+)
+
+const moveMetadataTimeout = 30 * time.Second
+const moveCopyTimeout = 5 * time.Minute
+const moveMetadataConcurrency = 8
+const movePayloadConcurrency = 4
+
+// moveRequest bounds one remote request group rather than the duration of a tree.
+func moveRequest[T any](ctx context.Context, timeout time.Duration, request func(context.Context) (T, error)) (T, error) {
+	requestCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	value, err := request(requestCtx)
+	if err == nil {
+		err = requestCtx.Err()
+	}
+	return value, err
+}
+
+func moveRequestError(ctx context.Context, timeout time.Duration, request func(context.Context) error) error {
+	_, err := moveRequest(ctx, timeout, func(requestCtx context.Context) (struct{}, error) { return struct{}{}, request(requestCtx) })
+	return err
+}
+
+// moveParallel waits for all admitted work before reporting an uncertain outcome.
+func moveParallel(ctx context.Context, count, limit int, task func(context.Context, int) error) error {
+	group, taskCtx := errgroup.WithContext(ctx)
+	work := make(chan int)
+	for worker := 0; worker < limit && worker < count; worker++ {
+		group.Go(func() error {
+			for index := range work {
+				if err := taskCtx.Err(); err != nil {
+					return err
+				}
+				if err := task(taskCtx, index); err != nil {
+					return err
+				}
+			}
+			return nil
+		})
+	}
+	group.Go(func() error {
+		defer close(work)
+		for index := 0; index < count; index++ {
+			select {
+			case work <- index:
+			case <-taskCtx.Done():
+				return taskCtx.Err()
+			}
+		}
+		return nil
+	})
+	return group.Wait()
+}
+
+// moveListingFS gives each directory listing its own deadline. The recursive
+// ListR feature is disabled so a large tree does not inherit one global timeout.
+type moveListingFS struct {
+	fs.Fs
+	features fs.Features
+}
+
+func newMoveListingFS(f fs.Fs) *moveListingFS {
+	wrapper := &moveListingFS{Fs: f, features: *f.Features()}
+	wrapper.features.ListR = nil
+	return wrapper
+}
+func (f *moveListingFS) Features() *fs.Features { return &f.features }
+func (f *moveListingFS) List(ctx context.Context, dir string) (fs.DirEntries, error) {
+	return moveRequest(ctx, moveMetadataTimeout, func(requestCtx context.Context) (fs.DirEntries, error) { return f.Fs.List(requestCtx, dir) })
+}
+
+// moveReceipts serializes append/fsync and progress publication. Different
+// workers may mutate distinct objects, but never the same receipt log together.
+type moveReceipts struct {
+	mu        sync.Mutex
+	completed int
+}
+
+func (r *moveReceipts) advance(vfs *VFS, phase string, total int) {
+	r.completed++
+	vfs.movePhase(phase, r.completed, total)
+}
+
+// moveCopyProof records identity observed on the newly copied destination.
+// LastModified need not equal the source when custom mtime is absent.
+type moveCopyProof struct {
+	checksum string
+	modTime  time.Time
+}
