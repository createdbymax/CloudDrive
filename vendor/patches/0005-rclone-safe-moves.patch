+)
+
+type measuredMoveFS struct {
+	fs.Fs
+	features                  fs.Features
+	metadataActive            atomic.Int32
+	metadataPeak              atomic.Int32
+	copyActive                atomic.Int32
+	copyPeak                  atomic.Int32
+	copied                    atomic.Int32
+	deleted                   atomic.Int32
+	deletionBeforeCopyBarrier atomic.Bool
+	listedMetadataCalls       atomic.Int32
+	expected                  int32
+}
+
+func movePeak(value *atomic.Int32, candidate int32) {
+	for old := value.Load(); candidate > old; old = value.Load() {
+		if value.CompareAndSwap(old, candidate) {
+			return
+		}
+	}
+}
+func measuredDelay(ctx context.Context, duration time.Duration) error {
+	timer := time.NewTimer(duration)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+func (f *measuredMoveFS) Features() *fs.Features { return &f.features }
+func (f *measuredMoveFS) NewObject(ctx context.Context, key string) (fs.Object, error) {
+	active := f.metadataActive.Add(1)
+	defer f.metadataActive.Add(-1)
+	movePeak(&f.metadataPeak, active)
+	if err := measuredDelay(ctx, time.Millisecond); err != nil {
+		return nil, err
+	}
+	o, err := f.Fs.NewObject(ctx, key)
+	if err != nil {
+		return nil, err
+	}
+	return &measuredMoveObject{Object: o, owner: f}, nil
+}
+func (f *measuredMoveFS) List(ctx context.Context, dir string) (fs.DirEntries, error) {
+	entries, err := f.Fs.List(ctx, dir)
+	for i, entry := range entries {
+		if o, ok := entry.(fs.Object); ok {
+			entries[i] = &listedMoveObject{Object: o, owner: f}
+		}
+	}
+	return entries, err
+}
+
+type listedMoveObject struct {
+	fs.Object
+	owner *measuredMoveFS
+}
+
+func (o *listedMoveObject) ModTime(ctx context.Context) time.Time {
+	o.owner.listedMetadataCalls.Add(1)
+	return o.Object.ModTime(ctx)
+}
+func (o *listedMoveObject) Hash(ctx context.Context, kind hash.Type) (string, error) {
+	o.owner.listedMetadataCalls.Add(1)
+	return o.Object.Hash(ctx, kind)
+}
+
+type measuredMoveObject struct {
+	fs.Object
+	owner *measuredMoveFS
+}
+
+func (o *measuredMoveObject) Remove(ctx context.Context) error {
+	if o.owner.copied.Load() != o.owner.expected {
+		o.owner.deletionBeforeCopyBarrier.Store(true)
+	}
+	err := o.Object.Remove(ctx)
+	if err == nil {
+		o.owner.deleted.Add(1)
+	}
+	return err
+}
+
+func TestSafeMovesBoundedParallelInventoryAndCopyBarrier(t *testing.T) {
+	v, base := moveFixture(t)
+	const count = 128
+	for i := 0; i < count; i++ {
+		movePut(t, base, fmt.Sprintf("Album/Sub%02d/file-%03d", i/8, i), "synthetic")
+	}
+	f := &measuredMoveFS{Fs: base, features: *base.Features(), expected: count}
+	realCopy := base.Features().Copy
+	f.features.Copy = func(ctx context.Context, o fs.Object, key string) (fs.Object, error) {
+		active := f.copyActive.Add(1)
+		defer f.copyActive.Add(-1)
+		movePeak(&f.copyPeak, active)
+		if err := measuredDelay(ctx, 5*time.Millisecond); err != nil {
+			return nil, err
+		}
+		if wrapped, ok := o.(*measuredMoveObject); ok {
+			o = wrapped.Object
+		}
+		copied, err := realCopy(ctx, o, key)
+		if err == nil {
+			f.copied.Add(1)
+		}
+		return copied, err
+	}
+	v.f = f
+	_, err := v.journalRemoteMove(context.Background(), "Album", "Moved", true)
+	require.NoError(t, err)
