+func TestSafeMovesCopyAcceptsNewDestinationLastModified(t *testing.T) {
+	v, f := moveFixture(t)
+	movePut(t, f, "a", "unchanged bytes")
+	copiedAt := time.Unix(40_000, 123)
+	realCopy := f.Features().Copy
+	f.Features().Copy = func(ctx context.Context, src fs.Object, dst string) (fs.Object, error) {
+		obj, err := realCopy(ctx, src, dst)
+		if err == nil {
+			err = obj.SetModTime(ctx, copiedAt)
+		}
+		return obj, err
+	}
+	_, err := v.journalRemoteMove(context.Background(), "a", "b", false)
+	require.NoError(t, err)
+	entry := v.safeMoves.journal.Objects[0]
+	require.True(t, entry.Verified)
+	require.True(t, entry.Deleted)
+	require.NotNil(t, entry.DestinationModTime)
+	require.True(t, copiedAt.Equal(*entry.DestinationModTime))
+	require.False(t, entry.ModTime.Equal(*entry.DestinationModTime))
+	moveExists(t, f, "a", false)
+	moveExists(t, f, "b", true)
+}
+
+func TestSafeMovesDestinationProofSurvivesRestartAndDetectsTimestampChange(t *testing.T) {
+	v, f := moveFixture(t)
+	movePut(t, f, "Album/a", "alpha")
+	movePut(t, f, "Album/b", "beta")
+	copiedAt := time.Unix(40_000, 0)
+	realCopy := f.Features().Copy
+	var calls atomic.Int32
+	copyWithNewTime := func(ctx context.Context, src fs.Object, dst string) (fs.Object, error) {
+		obj, err := realCopy(ctx, src, dst)
+		if err == nil {
+			err = obj.SetModTime(ctx, copiedAt)
+		}
+		return obj, err
+	}
+	f.Features().Copy = func(ctx context.Context, src fs.Object, dst string) (fs.Object, error) {
+		if calls.Add(1) == 2 {
+			waitForMoveReceipt(t, v.Opt.MoveJournal)
+			return nil, errors.New("injected interruption")
+		}
+		return copyWithNewTime(ctx, src, dst)
+	}
+	_, err := v.journalRemoteMove(context.Background(), "Album", "Moved", true)
+	require.Error(t, err)
+	// Reconstruct the original inventory plus synced receipts, as on restart.
+	raw, err := os.ReadFile(filepath.Join(v.Opt.MoveJournal, "move.json"))
+	require.NoError(t, err)
+	var restored moveJournal
+	require.NoError(t, json.Unmarshal(raw, &restored))
+	require.NoError(t, v.readMoveProgress(&restored))
+	var verified *moveObject
+	for i := range restored.Objects {
+		if restored.Objects[i].Verified {
+			verified = &restored.Objects[i]
+			break
+		}
+	}
+	require.NotNil(t, verified)
+	require.NotNil(t, verified.DestinationModTime)
+	require.True(t, copiedAt.Equal(*verified.DestinationModTime))
+	dst, err := f.NewObject(context.Background(), verified.Destination)
+	require.NoError(t, err)
+	require.True(t, v.destinationMatches(context.Background(), dst, verified))
+	// Same payload and checksum, changed destination identity: no source deletion.
+	require.NoError(t, dst.SetModTime(context.Background(), copiedAt.Add(time.Second)))
+	f.Features().Copy = copyWithNewTime
+	require.ErrorContains(t, v.runMove(context.Background(), &restored), "destination changed")
+	moveExists(t, f, "Album/a", true)
+	moveExists(t, f, "Album/b", true)
+}
+
+func TestSafeMovesLegacyReceiptUsesOriginalTimestamp(t *testing.T) {
+	v, f := moveFixture(t)
+	movePut(t, f, "a", "alpha")
+	ctx := context.Background()
+	src, err := f.NewObject(ctx, "a")
