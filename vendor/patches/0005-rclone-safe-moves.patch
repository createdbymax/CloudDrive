+// BusyMovePrefix reports dirty or open payloads before a directory rename.
+func (c *Cache) BusyMovePrefix(prefix string) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for name, item := range c.item {
+		if (name == prefix || strings.HasPrefix(name, prefix+"/")) && (item.IsDirty() || item.inUse()) {
+			return true
+		}
+	}
+	return false
