+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestNativeMoveKeepsUnrelatedMetadataResponsive(t *testing.T) {
+	ctx := context.Background()
+	f, e := fs.NewFs(ctx, ":memory:responsive-"+rand.Text())
+	require.NoError(t, e)
+	for _, key := range []string{"Album/a", "Other/keep"} {
+		_, e = f.Put(ctx, bytes.NewBufferString("payload"), object.NewStaticObjectInfo(key, time.Unix(100, 0), 7, true, nil, f))
+		require.NoError(t, e)
+	}
+	opt := vfscommon.Opt
+	opt.MoveJournal = filepath.Join(t.TempDir(), "moves")
+	v := vfs.New(ctx, f, &opt)
+	defer v.Shutdown()
+	handler, e := NewHandler(ctx, v, &Options{HandleLimit: 100})
+	require.NoError(t, e)
+	h := handler.(*Handler)
+	handle := h.ToHandle(h.billyFS, []string{"Album", "a"})
+	entered, finish := make(chan struct{}), make(chan struct{})
+	realCopy := f.Features().Copy
+	f.Features().Copy = func(ctx context.Context, o fs.Object, dst string) (fs.Object, error) {
+		close(entered)
+		<-finish
+		return realCopy(ctx, o, dst)
+	}
+	release := h.BeginRequest(gonfs.NFSProcedureRename)
+	start := time.Now()
+	e = h.billyFS.Rename("Album", "Moved")
+	release()
+	require.ErrorIs(t, e, syscall.EBUSY)
+	require.Less(t, time.Since(start), time.Second)
+	select {
+	case <-entered:
+	case <-time.After(2 * time.Second):
+		t.Fatal("move did not begin")
+	}
+	done := make(chan error, 1)
+	go func() {
+		release := h.BeginRequest(gonfs.NFSProcedureGetAttr)
+		defer release()
+		_, e := h.billyFS.Stat("Other/keep")
+		done <- e
+	}()
+	select {
+	case e := <-done:
+		require.NoError(t, e)
+	case <-time.After(time.Second):
+		t.Fatal("unrelated metadata waited for remote copy")
+	}
+	_, e = h.billyFS.Stat("Album/a")
+	require.ErrorIs(t, e, syscall.EBUSY)
+	close(finish)
+	require.Eventually(t, func() bool {
+		e := h.billyFS.Rename("Album", "Moved")
+		if errors.Is(e, syscall.EBUSY) {
+			return false
+		}
+		require.NoError(t, e)
+		return true
+	}, 5*time.Second, 10*time.Millisecond)
+	_, path, e := h.FromHandle(handle)
+	require.NoError(t, e)
+	require.Equal(t, []string{"Moved", "a"}, path)
+}
