+package vfs
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/hash"
+	"github.com/rclone/rclone/fs/rc"
+	"github.com/rclone/rclone/fs/walk"
+)
+
+const moveObjectLimit = 10000
+const moveJournalLimit = 32 << 20
+
+type moveObject struct {
+	DestinationMD5     string     `json:"destinationMD5"`
+	DestinationModTime *time.Time `json:"destinationModTime,omitempty"`
+	Source             string     `json:"source"`
+	Destination        string     `json:"destination"`
+	Size               int64      `json:"size"`
+	ModTime            time.Time  `json:"modTime"`
+	MD5                string     `json:"md5"`
+	Verified           bool       `json:"verified"`
+	Deleted            bool       `json:"deleted"`
+}
+
+type moveJournal struct {
+	ID          string       `json:"id"`
+	Version     int          `json:"version"`
+	Binding     string       `json:"binding"`
+	Source      string       `json:"source"`
+	Destination string       `json:"destination"`
+	Directory   bool         `json:"directory"`
+	Complete    bool         `json:"complete"`
+	Objects     []moveObject `json:"objects"`
+	Directories []string     `json:"directories"`
+}
+
+type safeMoveState struct {
+	native        *nativeMove
+	nativeHistory []nativeMove
+	epoch         uint64
+	commitRelease func()
+	replayed      bool
+	pending       bool
+	gate          sync.RWMutex
+	mu            sync.Mutex
+	loaded        bool
+	loadError     error
+	active        bool
+	phase         string
+	completed     int
+	total         int
+	problem       string
+	journal       *moveJournal
+	onResume      func(string, string) error
+	namespaceLock func() func()
+}
+
+func (vfs *VFS) moveBinding() string {
+	if vfs.Opt.MoveBinding != "" {
+		return vfs.Opt.MoveBinding
+	}
+	b := sha256.Sum256([]byte(fs.ConfigString(vfs.f)))
+	return hex.EncodeToString(b[:])
+}
+
+func movePath(p string) bool {
+	return p != "" && len(p) <= 4096 && p != "." && p != ".." && !strings.HasPrefix(p, "/") && !strings.HasPrefix(p, "../") && path.Clean(p) == p && !strings.ContainsRune(p, 0)
+}
+func moveUnder(p, prefix string) bool { return p == prefix || strings.HasPrefix(p, prefix+"/") }
+
+// loadMove is called with moves.mu held. Corrupt or foreign records fail closed.
+func (vfs *VFS) loadMove() {
+	m := &vfs.safeMoves
+	if m.loaded {
+		return
+	}
+	m.loaded = true
+	if vfs.Opt.MoveJournal == "" {
+		return
+	}
+	filename := filepath.Join(vfs.Opt.MoveJournal, "move.json")
+	info, err := os.Lstat(filename)
+	if errors.Is(err, os.ErrNotExist) {
+		return
+	}
+	if err == nil && (!info.Mode().IsRegular() || info.Size() > moveJournalLimit) {
+		err = fmt.Errorf("invalid move record")
+	}
+	var data []byte
+	if err == nil {
+		data, err = os.ReadFile(filename)
+	}
+	var j moveJournal
+	if err == nil {
+		err = json.Unmarshal(data, &j)
+	}
+	if err == nil && (j.Version != 1 || len(j.ID) != 32 || strings.ContainsAny(j.ID, "/\\.") || j.Binding != vfs.moveBinding() || !movePath(j.Source) || !movePath(j.Destination) || len(j.Objects) > moveObjectLimit || len(j.Directories) > moveObjectLimit) {
+		err = fmt.Errorf("invalid move binding")
+	}
+	if err == nil {
+		for _, o := range j.Objects {
+			if !movePath(o.Source) || !movePath(o.Destination) || !moveUnder(o.Source, j.Source) || o.Destination != j.Destination+strings.TrimPrefix(o.Source, j.Source) || o.Size < 0 {
+				err = fmt.Errorf("invalid move entry")
+				break
+			}
+		}
+		for _, d := range j.Directories {
+			if !movePath(d) || !moveUnder(d, j.Source) {
+				err = fmt.Errorf("invalid move directory")
+				break
+			}
+		}
+	}
+	if err != nil {
+		m.loadError = err
+		m.problem = "Move records could not be validated. Preserve them and use recovery."
+		return
+	}
+	if err = vfs.readMoveProgress(&j); err != nil {
+		m.loadError = err
+		m.problem = "Move progress records could not be validated. Preserve them and use recovery."
+		return
+	}
+	m.journal = &j
+	m.pending = !j.Complete
+	m.total = len(j.Objects)
+	if j.Complete {
+		m.phase = "completed"
+		m.completed = m.total
+	} else {
+		m.phase = "needsRecovery"
+		m.problem = "An interrupted move needs to finish. Choose Resume move."
+	}
+}
+
+// saveMove atomically and durably replaces a private destination-bound record.
+func (vfs *VFS) saveMove(j *moveJournal) error {
+	data, err := json.Marshal(j)
+	if err != nil {
+		return err
+	}
+	if len(data) > moveJournalLimit {
+		return fmt.Errorf("move exceeds record limit")
+	}
+	dir := vfs.Opt.MoveJournal
+	if err = os.MkdirAll(dir, 0700); err != nil {
+		return err
+	}
+	info, err := os.Lstat(dir)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 {
+		return fmt.Errorf("move directory must be private")
+	}
+	f, err := os.CreateTemp(dir, ".move-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	if _, err = f.Write(data); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(f.Name(), filepath.Join(dir, "move.json")); err != nil {
+		return err
+	}
+	d, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	return d.Sync()
+}
+
+func (vfs *VFS) movePhase(phase string, completed, total int) {
+	m := &vfs.safeMoves
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.phase = phase
+	m.completed = completed
+	m.total = total
+}
+
+// MoveStatus returns bounded move activity independently of the upload queue.
+func (vfs *VFS) MoveStatus() rc.Params {
+	m := &vfs.safeMoves
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	vfs.loadMove()
+	pending := m.loadError != nil || m.pending
+	active := m.active || (m.native != nil && !m.native.done)
+	phase := m.phase
+	if phase == "" {
+		phase = "idle"
+	}
+	if active && phase != "preparing" && phase != "copying" && phase != "verifying" && phase != "removing" {
+		phase = "preparing"
+	}
+	return rc.Params{"version": 1, "enabled": vfs.Opt.MoveJournal != "", "active": active, "needsRecovery": pending && !active, "phase": phase, "completed": m.completed, "total": m.total, "message": m.problem}
+}
+
+// LockMoveMutation excludes native writers during a rename or recovery.
+// The caller must release the returned lock after the file is closed.
+func (vfs *VFS) LockMoveMutation() (func(), error) {
+	m := &vfs.safeMoves
+	if !m.gate.TryRLock() {
+		return nil, syscall.EBUSY
+	}
+	m.mu.Lock()
+	vfs.loadMove()
+	var blocked error
+	if m.active || (m.native != nil && !m.native.done) {
+		blocked = syscall.EBUSY
+	} else if m.loadError != nil || m.pending {
+		blocked = syscall.EIO
+	}
+	if blocked == nil {
+		m.epoch++
+	}
+	m.mu.Unlock()
+	if blocked != nil {
+		m.gate.RUnlock()
+		return nil, blocked
+	}
+	return m.gate.RUnlock, nil
+}
+
+// SetMoveNamespaceLocker coordinates recovery with native handle resolution.
+func (vfs *VFS) SetMoveNamespaceLocker(fn func() func()) { vfs.safeMoves.namespaceLock = fn }
+
+// SetMoveHandleRenamer installs the native handler's recovery callback before serving.
+func (vfs *VFS) SetMoveHandleRenamer(fn func(string, string) error) { vfs.safeMoves.onResume = fn }
+
+func (vfs *VFS) safeRename(oldName, newName string, rename func() error) (err error) {
+	m := &vfs.safeMoves
+	m.gate.Lock()
+	defer m.gate.Unlock()
+	defer vfs.endMoveCommit()
+	m.mu.Lock()
+	vfs.loadMove()
+	if m.loadError != nil || m.pending {
+		m.mu.Unlock()
+		return syscall.EBUSY
+	}
+	previous := m.journal
+	m.replayed = false
+	m.mu.Unlock()
+	oldName = strings.Trim(oldName, "/")
+	newName = strings.Trim(newName, "/")
+	if !movePath(oldName) || !movePath(newName) {
+		return syscall.EINVAL
+	}
+	node, err := vfs.Stat(oldName)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) && previous != nil && previous.Complete && previous.Source == oldName && previous.Destination == newName {
+			for i := range previous.Objects {
+				r := &previous.Objects[i]
+				o, e := vfs.f.NewObject(vfs.ctx, r.Destination)
+				if e != nil {
+					return e
+				}
+				if !vfs.destinationMatches(vfs.ctx, o, r) {
+					return fmt.Errorf("completed destination changed")
+				}
+			}
+			m.mu.Lock()
+			m.replayed = true
+			m.mu.Unlock()
+			return nil
+		}
+		return err
+	}
+	if oldName == newName {
+		return nil
+	}
+	if node.IsDir() && moveUnder(newName, oldName) {
+		return syscall.EINVAL
+	}
+	dest, statErr := vfs.Stat(newName)
+	if statErr != nil && !errors.Is(statErr, os.ErrNotExist) {
+		return statErr
+	}
+	if dest != nil && dest.Path() != node.Path() {
+		if node.IsDir() != dest.IsDir() {
+			if dest.IsDir() {
+				return syscall.EISDIR
+			}
+			return syscall.ENOTDIR
+		}
+		if dest.IsDir() {
+			children, e := dest.(*Dir).ReadDirAll()
+			if e != nil {
+				return e
+			}
+			if len(children) > 0 {
+				return syscall.ENOTEMPTY
+			}
+		}
+	}
+	if vfs.cache != nil && (vfs.cache.BusyMovePrefix(oldName) || vfs.cache.BusyMovePrefix(newName)) {
+		return syscall.EBUSY
+	}
+	m.mu.Lock()
+	m.active = true
+	m.problem = ""
+	m.phase = "preparing"
+	m.completed = 0
+	m.total = 0
+	m.mu.Unlock()
+	defer func() {
+		m.mu.Lock()
+		m.active = false
+		if err != nil {
+			m.phase = "failed"
+			if m.pending {
+				m.phase = "needsRecovery"
+				m.problem = "Move stopped before all steps finished. Choose Resume move."
+				if errors.Is(err, context.DeadlineExceeded) {
+					m.problem = "A storage request timed out. Check the connection, then choose Resume move."
+				}
+			} else {
+				m.problem = "Move could not finish. Check the destination and try again."
+				if errors.Is(err, context.DeadlineExceeded) {
+					m.problem = "A storage request timed out. Check the connection and try the move again."
+				}
+			}
+		}
+		m.mu.Unlock()
+		vfs.noteMetadataChange(oldName, node.IsDir())
+		vfs.noteMetadataChange(newName, node.IsDir())
+	}()
+	if features := vfs.f.Features(); features.Copy == nil || features.Move != nil || features.DirMove != nil {
+		vfs.beginMoveCommit()
+	}
+	err = rename()
+	if err == nil {
+		vfs.beginMoveCommit()
+		if m.onResume != nil {
+			if e := m.onResume(oldName, newName); e != nil {
+				return e
+			}
+		}
+		m.mu.Lock()
+		j := m.journal
+		m.mu.Unlock()
+		if j != nil && !j.Complete {
+			j.Complete = true
+			if e := vfs.saveMove(j); e != nil {
+				j.Complete = false
+				return e
+			}
+		}
+		m.mu.Lock()
+		m.pending = false
+		m.active = false
+		m.mu.Unlock()
+		vfs.root.touchMoveDirectories()
+		vfs.movePhase("completed", m.total, m.total)
+	}
+	return err
+}
+
+func (vfs *VFS) objectMatches(ctx context.Context, o fs.Object, r *moveObject) bool {
+	if o.Size() != r.Size || !o.ModTime(ctx).Equal(r.ModTime) {
+		return false
+	}
+	if r.MD5 != "" {
+		h, e := o.Hash(ctx, hash.MD5)
+		return e == nil && h == r.MD5
+	}
+	return true
+}
+
+// journalRemoteMove copies every object before deleting any source object.
+func (vfs *VFS) journalRemoteMove(ctx context.Context, source, destination string, directory bool) (fs.Object, error) {
+	id := make([]byte, 16)
+	if _, err := rand.Read(id); err != nil {
+		return nil, err
+	}
+	j := &moveJournal{ID: hex.EncodeToString(id), Version: 1, Binding: vfs.moveBinding(), Source: source, Destination: destination, Directory: directory}
+	if directory {
+		// Walk callbacks run under the walker's coordinator lock. Collect keys
+		// only; metadata HEADs are fetched independently after the walk finishes.
+		err := walk.Walk(ctx, newMoveListingFS(vfs.f), source, true, -1, func(dir string, entries fs.DirEntries, listErr error) error {
+			if listErr != nil {
+				return listErr
+			}
+			if len(j.Directories) >= moveObjectLimit {
+				return fmt.Errorf("too many directories in move")
+			}
+			j.Directories = append(j.Directories, dir)
+			for _, entry := range entries {
+				if o, ok := entry.(fs.Object); ok {
+					if len(j.Objects) >= moveObjectLimit {
+						return fmt.Errorf("too many objects in move")
+					}
+					j.Objects = append(j.Objects, moveObject{Source: o.Remote(), Destination: destination + strings.TrimPrefix(o.Remote(), source)})
+				}
+			}
+			vfs.movePhase("preparing", 0, len(j.Objects))
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+		sort.Strings(j.Directories)
+	} else {
+		j.Objects = []moveObject{{Source: source, Destination: destination}}
+	}
+	prepared := &moveReceipts{}
+	vfs.movePhase("preparing", 0, len(j.Objects))
+	if err := moveParallel(ctx, len(j.Objects), moveMetadataConcurrency, func(taskCtx context.Context, index int) error {
+		r := &j.Objects[index]
+		_, err := moveRequest(taskCtx, moveMetadataTimeout, func(requestCtx context.Context) (struct{}, error) {
+			o, err := vfs.f.NewObject(requestCtx, r.Source)
+			if err != nil {
+				return struct{}{}, err
+			}
+			r.Size = o.Size()
+			if r.Size < 0 {
+				return struct{}{}, fmt.Errorf("source size is unknown")
+			}
+			r.ModTime = o.ModTime(requestCtx)
+			r.MD5, _ = o.Hash(requestCtx, hash.MD5)
+			return struct{}{}, nil
+		})
+		if err != nil {
+			return err
+		}
+		prepared.mu.Lock()
+		prepared.advance(vfs, "preparing", len(j.Objects))
+		prepared.mu.Unlock()
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	// Reserve checksum growth before publishing an inventory or copying objects.
+	initial, err := json.Marshal(j)
+	if err != nil {
+		return nil, err
+	}
+	if len(initial)+128*len(j.Objects) > moveJournalLimit {
+		return nil, fmt.Errorf("move exceeds record limit")
+	}
+	m := &vfs.safeMoves
+	m.mu.Lock()
+	m.journal = j
+	m.pending = true
+	m.total = len(j.Objects)
+	m.mu.Unlock()
+	// Publication can succeed even when the following directory fsync fails.
+	// Treat every persistence error as unresolved until an explicit retry.
+	if err := vfs.saveMove(j); err != nil {
+		return nil, err
+	}
+	if err := vfs.runMove(ctx, j); err != nil {
+		return nil, err
+	}
+	if !directory {
+		return moveRequest(ctx, moveMetadataTimeout, func(requestCtx context.Context) (fs.Object, error) { return vfs.f.NewObject(requestCtx, destination) })
+	}
+	return nil, nil
+}
+
+func (vfs *VFS) runMove(ctx context.Context, j *moveJournal) error {
+	for index, d := range j.Directories {
+		if err := moveRequestError(ctx, moveMetadataTimeout, func(requestCtx context.Context) error {
+			return vfs.f.Mkdir(requestCtx, j.Destination+strings.TrimPrefix(d, j.Source))
+		}); err != nil {
+			return err
+		}
+		vfs.movePhase("preparing", index+1, len(j.Directories))
+	}
+	copied := &moveReceipts{}
+	vfs.movePhase("copying", 0, len(j.Objects))
+	if err := moveParallel(ctx, len(j.Objects), movePayloadConcurrency, func(taskCtx context.Context, index int) error {
+		r := &j.Objects[index]
+		if r.Verified {
+			copied.mu.Lock()
+			copied.advance(vfs, "copying", len(j.Objects))
+			copied.mu.Unlock()
+			return nil
+		}
+		src, err := moveRequest(taskCtx, moveMetadataTimeout, func(requestCtx context.Context) (fs.Object, error) {
+			src, e := vfs.f.NewObject(requestCtx, r.Source)
+			if e != nil {
+				return nil, e
+			}
+			if !vfs.objectMatches(requestCtx, src, r) {
+				return nil, fmt.Errorf("source changed")
+			}
+			return src, nil
+		})
+		if err != nil {
+			return err
+		}
+		// Unverified objects may be recopied after an uncertain response or
+		// failed checkpoint. Never compare a fresh copy to stale destination proof.
+		r.DestinationMD5 = ""
+		r.DestinationModTime = nil
+		dst, err := moveRequest(taskCtx, moveCopyTimeout, func(requestCtx context.Context) (fs.Object, error) {
+			return vfs.f.Features().Copy(requestCtx, src, r.Destination)
+		})
+		if err != nil {
+			return err
+		}
+		proof, err := moveRequest(taskCtx, moveMetadataTimeout, func(requestCtx context.Context) (moveCopyProof, error) {
+			if dst == nil || dst.Size() != r.Size {
+				return moveCopyProof{}, fmt.Errorf("copy verification failed")
+			}
+			checksum, e := dst.Hash(requestCtx, hash.MD5)
+			if e != nil && !errors.Is(e, hash.ErrUnsupported) {
+				return moveCopyProof{}, e
+			}
+			if checksum != "" && r.MD5 != "" && checksum != r.MD5 {
+				return moveCopyProof{}, fmt.Errorf("copy checksum verification failed")
+			}
+			// S3 objects without custom mtime use LastModified. Copy changes
+			// that timestamp legitimately; retain the destination's own identity.
+			return moveCopyProof{checksum: checksum, modTime: dst.ModTime(requestCtx)}, nil
+		})
+		if err != nil {
+			return err
+		}
+		copied.mu.Lock()
+		defer copied.mu.Unlock()
+		r.DestinationMD5 = proof.checksum
+		r.DestinationModTime = &proof.modTime
+		r.Verified = true
+		if err := vfs.checkpointMove(j, index, false); err != nil {
+			r.Verified = false
+			r.DestinationMD5 = ""
+			r.DestinationModTime = nil
+			return err
+		}
+		copied.advance(vfs, "copying", len(j.Objects))
+		return nil
+	}); err != nil {
+		return err
+	}
+	// No deletion task is admitted until every copy and receipt has completed.
+	// Validate the complete remaining source/destination set before admitting
+	// deletion work; a known changed destination must not trigger other deletes.
+	deletionSources := make([]fs.Object, len(j.Objects))
+	checked := &moveReceipts{}
+	vfs.movePhase("verifying", 0, len(j.Objects))
+	if err := moveParallel(ctx, len(j.Objects), moveMetadataConcurrency, func(taskCtx context.Context, index int) error {
+		r := &j.Objects[index]
+		if !r.Deleted {
+			src, err := moveRequest(taskCtx, moveMetadataTimeout, func(requestCtx context.Context) (fs.Object, error) {
+				dst, e := vfs.f.NewObject(requestCtx, r.Destination)
+				if e != nil {
+					return nil, e
+				}
+				if !vfs.destinationMatches(requestCtx, dst, r) {
+					return nil, fmt.Errorf("destination changed before source removal")
+				}
+				src, e := vfs.f.NewObject(requestCtx, r.Source)
+				if e == nil {
+					if !vfs.objectMatches(requestCtx, src, r) {
+						return nil, fmt.Errorf("source changed before removal")
+					}
+					return src, nil
+				}
+				if !errors.Is(e, fs.ErrorObjectNotFound) {
+					return nil, e
+				}
+				return nil, nil
+			})
+			if err != nil {
+				return err
+			}
+			deletionSources[index] = src
+		}
+		checked.mu.Lock()
+		checked.advance(vfs, "verifying", len(j.Objects))
+		checked.mu.Unlock()
+		return nil
+	}); err != nil {
+		return err
+	}
+	removed := &moveReceipts{}
+	vfs.movePhase("removing", 0, len(j.Objects))
+	if err := moveParallel(ctx, len(j.Objects), movePayloadConcurrency, func(taskCtx context.Context, index int) error {
+		r := &j.Objects[index]
+		if r.Deleted {
+			removed.mu.Lock()
+			removed.advance(vfs, "removing", len(j.Objects))
+			removed.mu.Unlock()
+			return nil
+		}
+		if src := deletionSources[index]; src != nil {
+			if err := moveRequestError(taskCtx, moveMetadataTimeout, src.Remove); err != nil {
+				return err
+			}
+		}
+		removed.mu.Lock()
+		defer removed.mu.Unlock()
+		r.Deleted = true
+		if err := vfs.checkpointMove(j, index, true); err != nil {
+			r.Deleted = false
+			return err
+		}
+		removed.advance(vfs, "removing", len(j.Objects))
+		return nil
+	}); err != nil {
+		return err
+	}
+	for index := len(j.Directories) - 1; index >= 0; index-- {
+		if err := moveRequestError(ctx, moveMetadataTimeout, func(requestCtx context.Context) error {
+			err := vfs.f.Rmdir(requestCtx, j.Directories[index])
+			if errors.Is(err, fs.ErrorDirNotFound) {
+				return nil
+			}
+			return err
+		}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// ResumeMove reserves one recovery task; polling the status never starts mutations.
+func (vfs *VFS) ResumeMove() error {
+	m := &vfs.safeMoves
+	if !m.gate.TryLock() {
+		return syscall.EBUSY
+	}
+	m.mu.Lock()
+	vfs.loadMove()
+	if m.loadError != nil || m.journal == nil || !m.pending || m.active || vfs.f.Features().Copy == nil {
+		m.mu.Unlock()
+		m.gate.Unlock()
+		return fmt.Errorf("no resumable move")
+	}
+	j := m.journal
+	m.active = true
+	m.phase = "preparing"
+	m.problem = ""
+	m.replayed = false
+	m.mu.Unlock()
+	m.gate.Unlock()
+	go func() {
+		m.gate.Lock()
+		defer m.gate.Unlock()
+		defer vfs.endMoveCommit()
+		ctx := vfs.ctx
+		err := vfs.saveMove(j)
+		if err == nil {
+			err = vfs.runMove(ctx, j)
+		}
+		if err == nil {
+			vfs.beginMoveCommit()
+		}
+		if err == nil && m.onResume != nil {
+			err = m.onResume(j.Source, j.Destination)
+		}
+		if err == nil {
+			j.Complete = true
+			err = vfs.saveMove(j)
+			if err != nil {
+				j.Complete = false
+			}
+		}
+		vfs.beginMoveCommit()
+		vfs.root.ForgetAll()
+		vfs.noteMetadataChange(j.Source, j.Directory)
+		vfs.noteMetadataChange(j.Destination, j.Directory)
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		m.active = false
+		if err != nil {
+			m.phase = "needsRecovery"
+			m.problem = "Move could not resume. Check connection and permissions, then retry."
+		} else {
+			m.pending = false
+			m.phase = "completed"
+			if m.native != nil {
+				m.native.done = true
+				m.native.err = nil
+				m.native.epoch = m.epoch
+				m.rememberNativeMove(m.native)
+			}
+			m.completed = len(j.Objects)
+			m.problem = ""
+		}
+	}()
+	return nil
+}
+
+func init() {
+	rc.Add(rc.Call{Path: "vfs/moves", NoAuth: false, Title: "Read move activity or resume a retained move.", Fn: func(ctx context.Context, in rc.Params) (rc.Params, error) {
+		v, err := getVFS(in)
+		if err != nil {
+			return nil, err
+		}
+		if _, ok := in["resume"]; ok {
+			resume, e := in.GetBool("resume")
+			if e != nil || !resume {
+				return nil, fmt.Errorf("resume must be true")
+			}
+			if e = v.ResumeMove(); e != nil {
+				return nil, e
+			}
+		}
+		return v.MoveStatus(), nil
+	}})
+}
+
+// moveReceipt is a constant-size, synced append after each verified copy/delete.
+// Keeping receipts separate avoids rewriting the whole tree for every object.
+type moveReceipt struct {
+	DestinationMD5     string     `json:"destinationMD5"`
+	DestinationModTime *time.Time `json:"destinationModTime,omitempty"`
+	Index              int        `json:"index"`
+	Deleted            bool       `json:"deleted"`
+}
+
+func (vfs *VFS) checkpointMove(j *moveJournal, index int, deleted bool) error {
+	filename := filepath.Join(vfs.Opt.MoveJournal, j.ID+".progress")
+	f, err := os.OpenFile(filename, os.O_CREATE|os.O_APPEND|os.O_RDWR|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return err
+	}
+	if info.Size() > moveJournalLimit {
+		return fmt.Errorf("progress log too large")
+	}
+	if info.Size() > 0 {
+		last := make([]byte, 1)
+		if _, err = f.ReadAt(last, info.Size()-1); err != nil {
+			return err
+		}
+		if last[0] != '\n' {
+			data := make([]byte, info.Size())
+			if _, err = f.ReadAt(data, 0); err != nil {
+				return err
+			}
+			if err = f.Truncate(int64(bytes.LastIndexByte(data, '\n') + 1)); err != nil {
+				return err
+			}
+		}
+	}
+	data, err := json.Marshal(moveReceipt{Index: index, Deleted: deleted, DestinationMD5: j.Objects[index].DestinationMD5, DestinationModTime: j.Objects[index].DestinationModTime})
+	if err != nil {
+		return err
+	}
+	if _, err = f.Write(append(data, '\n')); err != nil {
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		return err
+	}
+	d, err := os.Open(vfs.Opt.MoveJournal)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	return d.Sync()
+}
+func (vfs *VFS) readMoveProgress(j *moveJournal) error {
+	if j.Complete {
+		return nil
+	}
+	filename := filepath.Join(vfs.Opt.MoveJournal, j.ID+".progress")
+	info, err := os.Lstat(filename)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() || info.Size() > moveJournalLimit {
+		return fmt.Errorf("invalid progress log")
+	}
+	f, err := os.Open(filename)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	reader := bufio.NewReader(f)
+	for {
+		line, readErr := reader.ReadBytes('\n')
+		if readErr == io.EOF {
+			break
+		}
+		if readErr != nil {
+			return readErr
+		}
+		var r moveReceipt
+		if err = json.Unmarshal(line, &r); err != nil {
+			return err
+		}
+		if r.Index < 0 || r.Index >= len(j.Objects) {
+			return fmt.Errorf("invalid receipt index")
+		}
+		o := &j.Objects[r.Index]
+		if r.Deleted && !o.Verified {
+			return fmt.Errorf("delete receipt without verification")
+		}
+		if r.DestinationModTime != nil || !o.Verified {
+			o.DestinationModTime = r.DestinationModTime
+		}
+		o.Verified = true
+		o.DestinationMD5 = r.DestinationMD5
+		if r.Deleted {
+			o.Deleted = true
+		}
+	}
+	return nil
+}
+
+// refreshRenamedObjects retains cached node identities while rebinding remote objects.
+// Remote lookups happen outside directory/file locks.
+func (d *Dir) refreshRenamedObjects(newPath string) error {
+	d.mu.RLock()
+	children := make(map[string]Node, len(d.items))
+	for name, node := range d.items {
+		children[name] = node
+	}
+	d.mu.RUnlock()
+	for name, node := range children {
+		target := path.Join(newPath, name)
+		switch x := node.(type) {
+		case *Dir:
+			if err := x.refreshRenamedObjects(target); err != nil {
+				return err
+			}
+		case *File:
+			o, err := moveRequest(d.vfs.ctx, moveMetadataTimeout, func(ctx context.Context) (fs.Object, error) { return d.f.NewObject(ctx, target) })
+			if err != nil {
+				return err
+			}
+			x.mu.Lock()
+			x.o = o
+			x.mu.Unlock()
+		}
+	}
+	return nil
+}
+
+// destinationMatches uses available checksums without treating multipart ETags as MD5.
+// A successful server-side copy receipt plus size/mtime is retained when no common hash exists.
+func (vfs *VFS) destinationMatches(ctx context.Context, o fs.Object, r *moveObject) bool {
+	// Older verified v1 records passed the original source-mtime comparison,
+	// so the source snapshot remains their expected destination timestamp.
+	expected := r.ModTime
+	if r.DestinationModTime != nil {
+		expected = *r.DestinationModTime
+	}
+	if o.Size() != r.Size || !o.ModTime(ctx).Equal(expected) {
+		return false
+	}
+	h, err := o.Hash(ctx, hash.MD5)
+	if r.DestinationMD5 != "" {
+		return err == nil && h == r.DestinationMD5
+	}
+	if h != "" && r.MD5 != "" {
+		return err == nil && h == r.MD5
+	}
+	return err == nil || errors.Is(err, hash.ErrUnsupported)
+}
+
+// MoveWasReplay prevents a completed RPC retry from invalidating destination handles.
+func (vfs *VFS) MoveWasReplay() bool {
+	m := &vfs.safeMoves
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.replayed
+}
+
+// touchMoveDirectories gives cached native identities a fresh grace period after
+// a long namespace operation without declaring unread directories populated.
+func (d *Dir) touchMoveDirectories() {
+	d.mu.Lock()
+	if !d.read.IsZero() {
+		d.read = time.Now()
+	}
+	var children []*Dir
+	for _, node := range d.items {
+		if child, ok := node.(*Dir); ok {
+			children = append(children, child)
+		}
+	}
+	d.mu.Unlock()
+	for _, child := range children {
+		child.touchMoveDirectories()
+	}
+}
