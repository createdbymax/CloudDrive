+	_, e := v.LockMoveMutation()
+	require.Error(t, e)
+	f.Features().Copy = realCopy
+	// A torn final append must not invalidate prior synced verification receipts.
+	logPath := filepath.Join(v.Opt.MoveJournal, v.safeMoves.journal.ID+".progress")
+	log, e := os.OpenFile(logPath, os.O_WRONLY|os.O_APPEND, 0600)
+	require.NoError(t, e)
+	_, e = log.WriteString("{\"index\":")
+	require.NoError(t, e)
