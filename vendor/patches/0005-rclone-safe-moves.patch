+	require.NoError(t, v.readMoveProgress(j))
+	require.Nil(t, j.Objects[0].DestinationModTime)
+	require.True(t, v.destinationMatches(ctx, dst, &j.Objects[0]))
+	require.NoError(t, dst.SetModTime(ctx, j.Objects[0].ModTime.Add(time.Second)))
+	require.False(t, v.destinationMatches(ctx, dst, &j.Objects[0]))
+	require.NoError(t, dst.SetModTime(ctx, j.Objects[0].ModTime))
