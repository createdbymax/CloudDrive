+// waitForMoveReceipt ensures injected parallel-copy failure happens after one
+// worker has reached its local durable-receipt section.
+func waitForMoveReceipt(t *testing.T, directory string) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		paths, _ := filepath.Glob(filepath.Join(directory, "*.progress"))
+		for _, p := range paths {
+			if info, e := os.Stat(p); e == nil && info.Size() > 0 {
+				return
+			}
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Error("copy-failure fixture never observed a verified receipt")
+}
