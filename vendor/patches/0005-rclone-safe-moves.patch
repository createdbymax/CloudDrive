+	require.GreaterOrEqual(t, f.copyPeak.Load(), int32(2))
+	require.LessOrEqual(t, f.copyPeak.Load(), int32(movePayloadConcurrency))
+	require.Equal(t, int32(count), f.copied.Load())
+	require.Equal(t, int32(count), f.deleted.Load())
+	require.False(t, f.deletionBeforeCopyBarrier.Load())
+	moveExists(t, base, "Album/Sub00/file-000", false)
+	moveExists(t, base, "Moved/Sub00/file-000", true)
+}
+
+func TestMoveRequestDeadlineCancelsStalledMetadata(t *testing.T) {
