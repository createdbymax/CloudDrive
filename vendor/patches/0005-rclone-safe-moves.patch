+//go:build unix
+
+package nfs
+
+import (
+	"bytes"
+	"crypto/rand"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/object"
+	"github.com/rclone/rclone/vfs"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNativeReplayCreationInvalidation(t *testing.T) {
+	for _, kind := range []string{"create", "open-create", "mkdir"} {
+		t.Run(kind, func(t *testing.T) {
+			ctx := t.Context()
+			remote, err := fs.NewFs(ctx, ":memory:replay-"+rand.Text())
+			require.NoError(t, err)
+			_, err = remote.Put(ctx, bytes.NewBufferString("old"), object.NewStaticObjectInfo("a", time.Unix(100, 0), 3, true, nil, remote))
+			require.NoError(t, err)
+			opt := vfscommon.Opt
+			opt.MoveJournal = filepath.Join(t.TempDir(), "moves")
+			mounted := vfs.New(ctx, remote, &opt)
+			defer mounted.Shutdown()
+			adapter := &FS{vfs: mounted}
+			wait := func() {
+				require.Eventually(t, func() bool { return mounted.MoveStatus()["active"] == false }, 5*time.Second, time.Millisecond)
+			}
+			require.ErrorIs(t, adapter.RenameRequest("a", "b", "xid-first"), syscall.EBUSY)
+			wait()
+			// Unrelated metadata increments the epoch, while a new XID still acknowledges.
+			require.NoError(t, adapter.Chmod("b", 0600))
+			require.NoError(t, adapter.RenameRequest("a", "b", "xid-retry"))
+			switch kind {
+			case "create", "open-create":
+				var fd interface {
+					Write([]byte) (int, error)
+					Close() error
+				}
+				if kind == "create" {
+					fd, err = adapter.Create("a")
+				} else {
+					fd, err = adapter.OpenFile("a", os.O_CREATE|os.O_WRONLY, 0600)
+				}
+				require.NoError(t, err)
+				_, err = fd.Write([]byte("new"))
+				require.NoError(t, err)
+				require.NoError(t, fd.Close())
+			case "mkdir":
+				require.NoError(t, adapter.MkdirAll("a", 0700))
+			}
+			// The original RPC remains idempotent, but a new RPC must validate/re-move.
+			require.NoError(t, adapter.RenameRequest("a", "b", "xid-first"))
+			require.ErrorIs(t, adapter.RenameRequest("a", "b", "xid-new"), syscall.EBUSY)
+			wait()
+			if kind != "mkdir" {
+				require.NoError(t, adapter.RenameRequest("a", "b", "xid-new"))
+				_, err = remote.NewObject(ctx, "a")
+				require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+			}
+		})
+	}
+}
