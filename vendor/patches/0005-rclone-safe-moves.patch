+func TestNativeMoveGuardsTerminateInactiveRecoveryRequests(t *testing.T) {
+	for _, mode := range []string{"active-native", "active-resume", "retained", "corrupt"} {
+		t.Run(mode, func(t *testing.T) {
+			v, _ := moveFixture(t)
+			m := &v.safeMoves
+			m.loaded = true
+			m.pending = true
+			m.journal = &moveJournal{Source: "Album", Destination: "Moved"}
+			expected := error(syscall.EIO)
+			switch mode {
+			case "active-native":
+				m.native = &nativeMove{source: "Album", destination: "Moved"}
+				expected = syscall.EBUSY
+			case "active-resume":
+				m.active = true
+				expected = syscall.EBUSY
+			case "corrupt":
+				m.loadError = errors.New("invalid journal")
+			}
+			for _, path := range []string{"Album", "Album/a", "Moved", "Moved/a"} {
+				require.ErrorIs(t, v.CheckMovePath(path), expected)
+			}
+			if mode == "corrupt" {
+				require.ErrorIs(t, v.CheckMovePath("Other/file"), syscall.EIO)
+			} else {
+				require.NoError(t, v.CheckMovePath("Other/file"))
+			}
+			release, err := v.LockMoveMutation()
+			require.ErrorIs(t, err, expected)
+			require.Nil(t, release)
+			// Failed guards must release the gate; explicit recovery can still reserve it.
+			require.True(t, m.gate.TryLock())
+			m.gate.Unlock()
+		})
+	}
+}
