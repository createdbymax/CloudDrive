+func TestSafeMovesCleanupCannotDiscardMovingIdentities(t *testing.T) {
+	v, f := moveFixture(t)
+	movePut(t, f, "Album/a", "alpha")
+	before, e := v.Stat("Album/a")
+	require.NoError(t, e)
+	entered, finish := make(chan struct{}), make(chan struct{})
+	realCopy := f.Features().Copy
+	f.Features().Copy = func(ctx context.Context, o fs.Object, dst string) (fs.Object, error) {
+		close(entered)
+		<-finish
+		return realCopy(ctx, o, dst)
+	}
+	renamed := make(chan error, 1)
+	go func() { renamed <- v.Rename("Album", "Renamed") }()
+	<-entered
+	v.root.mu.Lock()
+	v.root.read = time.Now().Add(-time.Hour)
+	v.root.mu.Unlock()
+	cleaned := make(chan struct{})
+	go func() { v.root.cacheCleanup(); close(cleaned) }()
+	select {
+	case <-cleaned:
+		t.Error("cleanup ran during an active namespace move")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(finish)
+	require.NoError(t, <-renamed)
+	select {
+	case <-cleaned:
+	case <-time.After(time.Second):
+		t.Fatal("cleanup remained blocked after rename")
+	}
+	after, e := v.Stat("Renamed/a")
+	require.NoError(t, e)
+	require.Equal(t, before.Inode(), after.Inode())
+}
