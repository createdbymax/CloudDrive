+	fresh := &VFS{f: f, ctx: ctx, Opt: v.Opt, root: v.root}
+	require.Equal(t, true, fresh.MoveStatus()["needsRecovery"])
+	require.NoError(t, fresh.ResumeMove())
+	require.Eventually(t, func() bool { return fresh.MoveStatus()["active"] == false }, 5*time.Second, 10*time.Millisecond)
+	require.Equal(t, false, fresh.MoveStatus()["needsRecovery"])
+	moveExists(t, f, "Album/a", false)
+	moveExists(t, f, "Album/Sub/b", false)
