--- /dev/null
+++ b/backend/s3/clouddrive_marker_test.go
@@ -0,0 +1,76 @@
+package s3
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCloudDriveNewDirectoryMarker(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		status    int
+		etag      string
+		wantError bool
+		want      []string
+	}{
+		{"confirmed empty", 200, `"d41d8cd98f00b204e9800998ecf8427e"`, false, []string{"PUT child", "HEAD parent"}},
+		{"concurrent existing marker", 412, "", false, []string{"PUT child"}},
+		{"denied", 403, "", true, []string{"PUT child"}},
+		{"opaque etag verifies by HEAD", 200, `"opaque"`, false, []string{"PUT child", "HEAD child", "HEAD parent"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var mu sync.Mutex
+			var requests []string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				name := "child"
+				if r.URL.Path == "/fixture/parent/" {
+					name = "parent"
+				} else if r.URL.Path != "/fixture/parent/child/" {
+					t.Errorf("unexpected path %s", r.URL.Path)
+				}
+				mu.Lock()
+				requests = append(requests, r.Method+" "+name)
+				mu.Unlock()
+				if r.Method == http.MethodPut {
+					if r.Header.Get("If-None-Match") != "*" || r.ContentLength != 0 {
+						t.Error("marker PUT must be an exclusive zero-byte creation")
+					}
+					if test.etag != "" {
+						w.Header().Set("ETag", test.etag)
+					}
+					w.WriteHeader(test.status)
+					return
+				}
+				w.Header().Set("Content-Length", "0")
+				w.Header().Set("Last-Modified", "Wed, 04 Nov 2026 12:00:00 GMT")
+				w.Header().Set("ETag", `"opaque"`)
+			}))
+			defer server.Close()
+			info, err := fs.Find("s3")
+			require.NoError(t, err)
+			config := fs.ConfigMap("s3", info.Options, "marker-fixture", configmap.Simple{
+				"provider": "Cloudflare", "access_key_id": "fixture", "secret_access_key": "fixture",
+				"region": "auto", "endpoint": server.URL, "directory_markers": "true",
+				"no_check_bucket": "true", "force_path_style": "true",
+			})
+			backend, err := NewFs(context.Background(), "marker-fixture", "fixture", config)
+			require.NoError(t, err)
+			err = backend.(*Fs).MkdirNew(context.Background(), "parent/child")
+			if test.wantError {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+			mu.Lock()
+			defer mu.Unlock()
+			require.Equal(t, test.want, requests)
+		})
+	}
+}
