+// CloudDrive's verified, immutable backing for released Finder cache ranges.
+package s3
+
+import (
+	"bytes"
+	"context"
+	"crypto/md5"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"io"
+	"regexp"
+	"strings"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	awss3 "github.com/aws/aws-sdk-go-v2/service/s3"
+	smithyhttp "github.com/aws/smithy-go/transport/http"
+)
+
+const spillPartSize = 4 << 20
+const spillMetadata = "clouddrive-spill-id"
+
+var spillObjectName = regexp.MustCompile(`^([.]clouddrive-spill-[a-f0-9]{64})/[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}/([a-f0-9]{64})$`)
+
+func (f *Fs) checkSpillPrefix(prefix string) error {
+	if f.rootBucket == "" || f.rootDirectory == "" || strings.HasPrefix(f.rootDirectory, ".") ||
+		f.opt.Provider != "Cloudflare" || f.opt.VersionAt.IsSet() || f.opt.Versions || f.opt.Decompress {
+		return errors.New("CloudDrive writeback requires a dedicated R2 prefix")
+	}
+	endpoint := strings.TrimRight(f.opt.Endpoint, "/")
+	for _, base := range []string{endpoint, endpoint + "/"} {
+		expected := fmt.Sprintf(".clouddrive-spill-%x", sha256.Sum256([]byte(base+"/"+f.rootBucket+"/"+f.rootDirectory)))
+		if prefix == expected {
+			return nil
+		}
+	}
+	return errors.New("writeback namespace does not match this R2 destination")
+}
+
+func spillStatus(err error, code int) bool {
+	var response *smithyhttp.ResponseError
+	return errors.As(err, &response) && response.HTTPStatusCode() == code
+}
+
+func (f *Fs) spillGet(ctx context.Context, key string, max int64) ([]byte, error) {
+	obj, err := f.c.GetObject(ctx, &awss3.GetObjectInput{Bucket: aws.String(f.rootBucket), Key: aws.String(key)})
+	if err != nil {
+		return nil, err
+	}
+	defer obj.Body.Close()
+	if obj.ContentLength == nil || *obj.ContentLength > max || obj.Metadata[spillMetadata] != key {
+		return nil, errors.New("invalid CloudDrive writeback object identity or length")
+	}
+	data, err := io.ReadAll(io.LimitReader(obj.Body, max+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(data)) != *obj.ContentLength || int64(len(data)) > max {
+		return nil, errors.New("incomplete CloudDrive writeback object")
+	}
+	return data, nil
+}
+
+func (f *Fs) spillCreate(ctx context.Context, key string, data []byte) (*awss3.PutObjectOutput, error) {
+	checksum := md5.Sum(data)
+	return f.c.PutObject(ctx, &awss3.PutObjectInput{Bucket: aws.String(f.rootBucket), Key: aws.String(key),
+		IfNoneMatch: aws.String("*"), ContentLength: aws.Int64(int64(len(data))), ContentMD5: aws.String(base64.StdEncoding.EncodeToString(checksum[:])),
+		Body: bytes.NewReader(data), Metadata: map[string]string{spillMetadata: key}})
+}
+
+// InitSpillNamespace refuses a pre-existing unmarked tree. The marker also binds later
+// launches to the mount's logical destination. No regular mounted key can resolve here.
+func (f *Fs) InitSpillNamespace(ctx context.Context, prefix string) error {
+	if err := f.checkSpillPrefix(prefix); err != nil {
+		return err
+	}
+	key := prefix + "/owner-v1"
+	marker := []byte("CloudDrive spill v1\n" + f.rootBucket + "/" + f.rootDirectory + "\n")
+	check := func() error {
+		data, err := f.spillGet(ctx, key, 4096)
+		if err != nil {
+			return err
+		}
+		if !bytes.Equal(data, marker) {
+			return errors.New("CloudDrive spill namespace is already owned")
+		}
+		return nil
+	}
+	if err := check(); !spillStatus(err, 404) {
+		return err
+	}
+	result, err := f.c.ListObjectsV2(ctx, &awss3.ListObjectsV2Input{Bucket: aws.String(f.rootBucket), Prefix: aws.String(prefix), MaxKeys: aws.Int32(1)})
+	if err != nil {
+		return err
+	}
+	if len(result.Contents) > 0 {
+		return check()
+	}
+	if _, err = f.spillCreate(ctx, key, marker); err != nil {
+		if reconciled := check(); reconciled != nil {
+			return fmt.Errorf("create writeback namespace: %w", err)
+		}
+		return nil
+	}
+	return check()
+}
+
+func (f *Fs) spillDigest(key string) (string, error) {
+	groups := spillObjectName.FindStringSubmatch(key)
+	if groups == nil {
+		return "", errors.New("invalid CloudDrive spill key")
+	}
+	if err := f.checkSpillPrefix(groups[1]); err != nil {
+		return "", err
+	}
+	return groups[2], nil
+}
+
+func (f *Fs) StoreSpillChunk(ctx context.Context, key string, data []byte) error {
+	digest, err := f.spillDigest(key)
+	if err != nil {
+		return err
+	}
+	if len(data) == 0 || len(data) > spillPartSize || fmt.Sprintf("%x", sha256.Sum256(data)) != digest {
+		return errors.New("invalid CloudDrive writeback payload")
+	}
+	result, putErr := f.spillCreate(ctx, key, data)
+	// R2 validates Content-MD5 before accepting a single-part PUT. Match its independent
+	// ETag before releasing local bytes. Reconcile any other response by hashing a GET.
+	if putErr == nil && aws.ToString(result.ETag) == fmt.Sprintf("\"%x\"", md5.Sum(data)) {
+		return nil
+	}
+	if _, err = f.ReadSpillChunk(ctx, key); err != nil {
+		if putErr != nil {
+			return fmt.Errorf("store writeback chunk: %w", putErr)
+		}
+		return err
+	}
+	return nil
+}
+
+func (f *Fs) ReadSpillChunk(ctx context.Context, key string) ([]byte, error) {
+	digest, err := f.spillDigest(key)
+	if err != nil {
+		return nil, err
+	}
+	data, err := f.spillGet(ctx, key, spillPartSize)
+	if err != nil {
+		return nil, err
+	}
+	if fmt.Sprintf("%x", sha256.Sum256(data)) != digest {
+		return nil, errors.New("CloudDrive writeback checksum mismatch")
+	}
+	return data, nil
+}
+
+// R2 does not currently support If-Match on DeleteObject. Only our write-once
+// UUID/content-addressed staging keys use this path. Verify ownership and every
+// byte immediately before removal. Ordinary mounted objects never pass spillDigest.
+func (f *Fs) DeleteSpillChunk(ctx context.Context, key string) error {
+	if _, err := f.ReadSpillChunk(ctx, key); err != nil {
+		if spillStatus(err, 404) {
+			return nil
+		}
+		return err
+	}
+	prefix, _, _ := strings.Cut(key, "/")
+	marker, err := f.spillGet(ctx, prefix+"/owner-v1", 4096)
+	if err != nil {
+		return err
+	}
+	if string(marker) != "CloudDrive spill v1\n"+f.rootBucket+"/"+f.rootDirectory+"\n" {
+		return errors.New("writeback cleanup ownership changed")
+	}
+	_, err = f.c.DeleteObject(ctx, &awss3.DeleteObjectInput{Bucket: aws.String(f.rootBucket), Key: aws.String(key)})
+	return err
+}
