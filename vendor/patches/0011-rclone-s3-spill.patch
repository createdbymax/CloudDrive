+package s3
+
+import (
+	"context"
+	"crypto/md5"
+	"crypto/sha256"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/credentials"
+	awss3 "github.com/aws/aws-sdk-go-v2/service/s3"
+)
+
+func TestCloudDriveSpillProvider(t *testing.T) {
+	type object struct {
+		data []byte
+		id   string
+		etag string
+	}
+	objects := map[string]object{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		key := strings.TrimPrefix(r.URL.Path, "/fixture/")
+		if r.URL.Query().Get("list-type") == "2" {
+			fmt.Fprint(w, "<ListBucketResult><Name>fixture</Name>")
+			for k := range objects {
+				if strings.HasPrefix(k, r.URL.Query().Get("prefix")) {
+					fmt.Fprintf(w, "<Contents><Key>%s</Key></Contents>", k)
+					break
+				}
+			}
+			fmt.Fprint(w, "</ListBucketResult>")
+			return
+		}
+		o, exists := objects[key]
+		switch r.Method {
+		case "PUT":
+			if r.Header.Get("If-None-Match") != "*" {
+				t.Error("missing exclusive create")
+			}
+			if exists {
+				w.WriteHeader(412)
+				return
+			}
+			b, _ := io.ReadAll(r.Body)
+			md := md5.Sum(b)
+			if r.Header.Get("Content-MD5") != base64.StdEncoding.EncodeToString(md[:]) {
+				t.Error("missing transport checksum")
+			}
+			o = object{b, r.Header.Get("x-amz-meta-clouddrive-spill-id"), fmt.Sprintf("\"%x\"", md)}
+			objects[key] = o
+			w.Header().Set("ETag", o.etag)
+		case "GET", "HEAD":
+			if !exists {
+				w.WriteHeader(404)
+				return
+			}
+			w.Header().Set("ETag", o.etag)
+			w.Header().Set("Content-Length", strconv.Itoa(len(o.data)))
+			w.Header().Set("X-Amz-Meta-Clouddrive-Spill-Id", o.id)
+			if r.Method == "GET" {
+				_, _ = w.Write(o.data)
+			}
+		case "DELETE":
+			// Mirror R2: conditional DELETE is unsupported.
+			if r.Header.Get("If-Match") != "" {
+				w.WriteHeader(http.StatusNotImplemented)
+				return
+			}
+			delete(objects, key)
+			w.WriteHeader(204)
+		default:
+			t.Errorf("unexpected method %s", r.Method)
+		}
+	}))
+	defer server.Close()
+	f := &Fs{opt: Options{Endpoint: server.URL, Provider: "Cloudflare"}, rootBucket: "fixture", rootDirectory: "personal"}
+	f.c = awss3.New(awss3.Options{Region: "auto", BaseEndpoint: aws.String(server.URL), UsePathStyle: true, Credentials: credentials.NewStaticCredentialsProvider("fixture", "fixture", "")})
+	prefix := fmt.Sprintf(".clouddrive-spill-%x", sha256.Sum256([]byte(server.URL+"/fixture/personal")))
+	ctx := context.Background()
+	if f.InitSpillNamespace(ctx, ".clouddrive-spill-"+strings.Repeat("a", 64)) == nil {
+		t.Fatal("accepted unrelated binding")
+	}
+	objects[prefix+"/foreign"] = object{}
+	if f.InitSpillNamespace(ctx, prefix) == nil {
+		t.Fatal("claimed foreign namespace")
+	}
+	delete(objects, prefix+"/foreign")
+	if e := f.InitSpillNamespace(ctx, prefix); e != nil {
+		t.Fatal(e)
+	}
+	if e := f.InitSpillNamespace(ctx, prefix); e != nil {
+		t.Fatal(e)
+	}
+	payload := []byte("verified data")
+	key := fmt.Sprintf("%s/b00b16c8-dee9-4c83-80bc-0caf23a44ab3/%x", prefix, sha256.Sum256(payload))
+	if e := f.StoreSpillChunk(ctx, key, payload); e != nil {
+		t.Fatal(e)
+	}
+	if e := f.StoreSpillChunk(ctx, key, payload); e != nil {
+		t.Fatal(e)
+	}
+	if e := f.StoreSpillChunk(ctx, key, []byte("wrong")); e == nil {
+		t.Fatal("accepted wrong source")
+	}
+	b, e := f.ReadSpillChunk(ctx, key)
+	if e != nil || string(b) != string(payload) {
+		t.Fatal(e)
+	}
+	valid := objects[key]
+	bad := valid
+	bad.data = []byte("damaged")
+	objects[key] = bad
+	if _, e = f.ReadSpillChunk(ctx, key); e == nil {
+		t.Fatal("read corrupt payload")
+	}
+	if e = f.StoreSpillChunk(ctx, key, payload); e == nil {
+		t.Fatal("reused damaged object")
+	}
+	if e = f.DeleteSpillChunk(ctx, key); e == nil || objects[key].data == nil {
+		t.Fatal("deleted a checksum-mismatched spill")
+	}
+	if e = f.DeleteSpillChunk(ctx, "ordinary"); e == nil {
+		t.Fatal("accepted ordinary key for cleanup")
+	}
+	markerKey := prefix + "/owner-v1"
+	originalMarker := objects[markerKey]
+	corruptMarker := originalMarker
+	corruptMarker.data = []byte("different owner")
+	objects[markerKey] = corruptMarker
+	objects[key] = valid
+	if e = f.DeleteSpillChunk(ctx, key); e == nil || objects[key].data == nil {
+		t.Fatal("deleted without a current verified marker")
+	}
+	objects[markerKey] = originalMarker
+	bad.id = "foreign"
+	objects[key] = bad
+	if e = f.DeleteSpillChunk(ctx, key); e == nil {
+		t.Fatal("deleted unrelated object")
+	}
+	objects[key] = valid
+	if e = f.DeleteSpillChunk(ctx, key); e != nil {
+		t.Fatal(e)
+	}
+	if e = f.DeleteSpillChunk(ctx, key); e != nil {
+		t.Fatal(e)
+	}
+	if len(objects) != 1 {
+		t.Fatal("unexpected orphan objects")
+	}
+}
