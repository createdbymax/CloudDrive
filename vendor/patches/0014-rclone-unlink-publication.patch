+// PrepareUnlink returns the last publication receipt (including cache reloads,
+// which publish without a File callback). A cancelled HTTP PUT can still commit
+// remotely. Only retract a dirty new file if its transfer provably never began.
+func (c *Cache) PrepareUnlink(name string, hasRemote bool) (fs.Object, bool) {
+	c.mu.Lock()
+	item := c.item[clean(name)]
+	c.mu.Unlock()
+	if item == nil {
+		return nil, true
+	}
+	item.mu.Lock()
+	defer item.mu.Unlock()
+	if !item.info.Dirty {
+		return item.o, true
+	}
+	if hasRemote || item.o != nil || item.opens != 0 || item.publishAttempted {
+		return nil, false
+	}
+	return nil, c.writeback.RetractUnstarted(item.writeBackID)
+}
