+// RetractUnstarted atomically removes work only if it has never been dispatched.
+func (wb *WriteBack) RetractUnstarted(id Handle) bool {
+	wb.mu.Lock()
+	defer wb.mu.Unlock()
+	item := wb.lookup[id]
+	if item == nil || item.uploading || item.tries != 0 {
+		return false
+	}
+	return wb._remove(id)
+}
