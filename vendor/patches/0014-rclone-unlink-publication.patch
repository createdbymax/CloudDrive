+package vfscache
+
+import (
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCloudDriveUnlinkAdmission(t *testing.T) {
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.WriteBack = fs.Duration(time.Hour)
+	_, cache := newTestCacheOpt(t, opt)
+	item := cache.Item("new")
+	itemWrite(t, item, "original")
+	_, ok := cache.PrepareUnlink("new", false)
+	require.False(t, ok, "a writer can still enqueue publication")
+	require.NoError(t, item.Close(nil))
+	_, ok = cache.PrepareUnlink("new", true)
+	require.False(t, ok, "pending edits of an existing cloud object must be retained")
+	item.mu.Lock()
+	item.publishAttempted = true
+	item.mu.Unlock()
+	_, ok = cache.PrepareUnlink("new", false)
+	require.False(t, ok, "an earlier attempt can have committed despite an error")
+	require.Len(t, cache.writeback.Queue(), 1)
+	item.mu.Lock()
+	item.publishAttempted = false
+	item.mu.Unlock()
+	_, ok = cache.PrepareUnlink("new", false)
+	require.True(t, ok, "retract only a never-dispatched brand new file")
+	require.Empty(t, cache.writeback.Queue())
+	cache.Remove("new")
+}
