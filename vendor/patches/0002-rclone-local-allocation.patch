+//go:build unix
+
+package nfs
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	gonfs "github.com/willscott/go-nfs"
+)
+
+func TestAllocationPreservesLogicalSizeAndUnknownFallback(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "fixture")
+	if err := os.WriteFile(path, make([]byte, 8192), 0600); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, test := range []struct {
+		name     string
+		used     uint64
+		err      error
+		expected uint64
+	}{
+		{"cloud-only", 0, nil, 0},
+		{"partially-cached", 4096, nil, 4096},
+		{"pending-upload", 8192, nil, 8192},
+		{"unavailable", 0, errors.New("stat denied"), 8192},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			wrapped := allocatedFileInfo{FileInfo: info, allocation: func() (uint64, error) { return test.used, test.err }}
+			attr := gonfs.ToFileAttribute(wrapped, path)
+			if attr.Filesize != 8192 || attr.Used != test.expected {
+				t.Fatalf("attribute size/used = %d/%d; want8192/%d", attr.Filesize, attr.Used, test.expected)
+			}
+		})
+	}
+	attr := gonfs.ToFileAttribute(info, path)
+	if attr.Used != 8192 {
+		t.Fatalf("unrelated file fallback changed to%d", attr.Used)
+	}
+}
