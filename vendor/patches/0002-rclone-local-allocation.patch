+//go:build unix
+
+package vfs
+
+import "fmt"
+
+// CachedAllocatedBytes reports local physical data-cache allocation only. It
+// never creates a cache entry or downloads a remote object.
+func (vfs *VFS) CachedAllocatedBytes(name string) (uint64, error) {
+	if vfs.cache == nil {
+		return 0, fmt.Errorf("local data cache is not configured")
+	}
+	return vfs.cache.AllocatedBytes(name)
+}
