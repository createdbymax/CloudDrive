+//go:build unix
+
+package nfs
+
+import (
+	"github.com/rclone/rclone/vfs"
+	"os"
+)
+
+// allocatedFileInfo adds allocation without changing file size, inode, UID/GID
+// or the node's shared Sys payload. go-nfs reads this optional interface when
+// constructing every NFS attribute response.
+type allocatedFileInfo struct {
+	os.FileInfo
+	allocation func() (uint64, error)
+}
+
+func (info allocatedFileInfo) AllocatedBytes() uint64 {
+	used, err := info.allocation()
+	if err == nil {
+		return used
+	}
+	// NFS has no unknown allocation value. Preserve the upstream conservative
+	// logical-size fallback instead of falsely claiming zero on an error.
+	return uint64(info.FileInfo.Size())
+}
+
+func withAllocation(info os.FileInfo) os.FileInfo {
+	node, ok := info.(*vfs.File)
+	if !ok || !info.Mode().IsRegular() {
+		return info
+	}
+	return allocatedFileInfo{FileInfo: info, allocation: func() (uint64, error) {
+		return node.VFS().CachedAllocatedBytes(node.CachePath())
+	}}
+}
