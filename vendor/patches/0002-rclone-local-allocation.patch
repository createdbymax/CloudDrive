+//go:build unix
+
+package vfscache
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+)
+
+func TestAllocatedBytesSparseAndAbsent(t *testing.T) {
+	root := t.TempDir()
+	c := &Cache{root: root}
+	used, err := c.AllocatedBytes("absent")
+	if err != nil || used != 0 {
+		t.Fatalf("absent allocation = %d, %v", used, err)
+	}
+	file, err := os.Create(filepath.Join(root, "sparse"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	const logical = 64 << 20
+	if err := file.Truncate(logical); err != nil {
+		t.Fatal(err)
+	}
+	before, err := c.AllocatedBytes("sparse")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if before >= logical {
+		t.Fatalf("sparse file was reported fully allocated: %d", before)
+	}
+	if _, err := file.WriteAt(make([]byte, 4096), 32<<20); err != nil {
+		t.Fatal(err)
+	}
+	if err := file.Sync(); err != nil {
+		t.Fatal(err)
+	}
+	info, err := file.Stat()
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected := uint64(info.Sys().(*syscall.Stat_t).Blocks) * 512
+	after, err := c.AllocatedBytes("sparse")
+	if err != nil || after != expected || after == 0 || after >= logical {
+		t.Fatalf("partial physical allocation = %d, want %d (error %v)", after, expected, err)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(filepath.Join(root, "sparse")); err != nil {
+		t.Fatal(err)
+	}
+	used, err = c.AllocatedBytes("sparse")
+	if err != nil || used != 0 {
+		t.Fatalf("evicted allocation = %d, %v", used, err)
+	}
+}
+
+func TestAllocatedBytesRejectsUnsafeOrUnknownTargets(t *testing.T) {
+	root := t.TempDir()
+	c := &Cache{root: root}
+	for _, name := range []string{"", "..", "../outside", "a/../../outside"} {
+		if _, err := c.AllocatedBytes(name); err == nil {
+			t.Fatalf("accepted path %q", name)
+		}
+	}
+	outside := filepath.Join(t.TempDir(), "preserved")
+	if err := os.WriteFile(outside, []byte("preserved"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "link")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.AllocatedBytes("link"); err == nil {
+		t.Fatal("followed symlink")
+	}
+	if err := os.Symlink(filepath.Dir(outside), filepath.Join(root, "linked-parent")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.AllocatedBytes("linked-parent/preserved"); err == nil {
+		t.Fatal("followed parent symlink")
+	}
+	if err := os.Mkdir(filepath.Join(root, "directory"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.AllocatedBytes("directory"); err == nil {
+		t.Fatal("reported directory as file")
+	}
+	if got, err := os.ReadFile(outside); err != nil || string(got) != "preserved" {
+		t.Fatal("outside target changed")
+	}
+}
