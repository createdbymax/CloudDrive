+//go:build unix
+
+package vfscache
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+)
+
+// AllocatedBytes reports physical blocks occupied by a cache data file, without
+// opening it, creating a cache item, fetching data, or counting metadata files.
+// An absent data file has no local allocation. Other errors remain errors so a
+// caller cannot accidentally present an unreadable cache as cloud-only.
+func (c *Cache) AllocatedBytes(name string) (uint64, error) {
+	name = clean(name)
+	if name == "" || name == ".." || strings.HasPrefix(name, "../") {
+		return 0, fmt.Errorf("invalid cache allocation path")
+	}
+	candidate := c.toOSPath(name)
+	relative, err := filepath.Rel(c.root, candidate)
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) || filepath.IsAbs(relative) {
+		return 0, fmt.Errorf("cache allocation path escapes its root")
+	}
+	// Lstat each component rather than following a cache symlink to another
+	// file. A missing component means no data file is allocated locally.
+	current := c.root
+	components := strings.Split(relative, string(filepath.Separator))
+	for i, part := range components {
+		current = filepath.Join(current, part)
+		info, err := os.Lstat(current)
+		if os.IsNotExist(err) {
+			return 0, nil
+		}
+		if err != nil {
+			return 0, err
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return 0, fmt.Errorf("cache allocation path is a symlink")
+		}
+		if i != len(components)-1 {
+			if !info.IsDir() {
+				return 0, fmt.Errorf("cache allocation parent is not a directory")
+			}
+			continue
+		}
+		if !info.Mode().IsRegular() {
+			return 0, fmt.Errorf("cache allocation target is not a regular file")
+		}
+		st, ok := info.Sys().(*syscall.Stat_t)
+		if !ok || st.Blocks < 0 || uint64(st.Blocks) > math.MaxUint64/512 {
+			return 0, fmt.Errorf("cache physical allocation is unavailable")
+		}
+		return uint64(st.Blocks) * 512, nil
+	}
+	return 0, fmt.Errorf("cache allocation target is unavailable")
+}
