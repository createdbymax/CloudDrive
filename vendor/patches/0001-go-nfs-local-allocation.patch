+// CloudDrive addition (2026-11-03): local-allocation attribute tests.
+package nfs
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+type explicitAllocationInfo struct {
+	os.FileInfo
+	used uint64
+}
+
+func (i explicitAllocationInfo) AllocatedBytes() uint64 { return i.used }
+
+func TestOptionalAllocatedBytesPreservesLogicalFileSize(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "allocation")
+	if err := os.WriteFile(path, make([]byte, 8192), 0600); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, used := range []uint64{0, 4096, 8192} {
+		attrs := ToFileAttribute(explicitAllocationInfo{info, used}, path)
+		if attrs.Filesize != 8192 || attrs.Used != used {
+			t.Fatalf("size/used=%d/%d, want8192/%d", attrs.Filesize, attrs.Used, used)
+		}
+	}
+	fallback := ToFileAttribute(info, path)
+	if fallback.Filesize != 8192 || fallback.Used != 8192 {
+		t.Fatal("unrelated allocation fallback changed")
+	}
+}
