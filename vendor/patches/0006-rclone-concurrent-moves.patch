+package vfs
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+	"syscall"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/operations"
+	"github.com/rclone/rclone/fs/rc"
+)
+
+// Fixed slots bound both active provider work and the records scanned at startup.
+// Slot zero preserves the original v1 journal and all completion receipts.
+func (v *VFS) slots() [4]*safeMoveState {
+	return [4]*safeMoveState{&v.safeMoves, &v.moveSlots[0], &v.moveSlots[1], &v.moveSlots[2]}
+}
+func (v *VFS) slotIndex(m *safeMoveState) int {
+	for i, s := range v.slots() {
+		if s == m {
+			return i
+		}
+	}
+	panic("unknown move slot")
+}
+func moveRecordName(slot int) string {
+	if slot == 0 {
+		return "move.json"
+	}
+	return fmt.Sprintf("move-%d.json", slot)
+}
+func newMoveID() (string, error) {
+	var id [16]byte
+	_, err := rand.Read(id[:])
+	return hex.EncodeToString(id[:]), err
+}
+func (v *VFS) normMove(p string) string {
+	ci := fs.GetConfig(v.ctx)
+	return operations.ToNormal(p, !ci.NoUnicodeNormalization, ci.IgnoreCaseSync || v.Opt.CaseInsensitive)
+}
+func (v *VFS) within(p, root string) bool { return moveUnder(v.normMove(p), v.normMove(root)) }
+func intersect(a, b string) bool          { return moveUnder(a, b) || moveUnder(b, a) }
+func (v *VFS) overlaps(s, d, otherS, otherD string) bool {
+	s, d, otherS, otherD = v.normMove(s), v.normMove(d), v.normMove(otherS), v.normMove(otherD)
+	return intersect(s, otherS) || intersect(s, otherD) || intersect(d, otherS) || intersect(d, otherD)
+}
+func (m *safeMoveState) busy() bool { return m.active || (m.native != nil && !m.native.done) }
+func (m *safeMoveState) endpoints() (string, string) {
+	if m.native != nil && !m.native.done {
+		return m.native.source, m.native.destination
+	}
+	if m.journal != nil {
+		return m.journal.Source, m.journal.Destination
+	}
+	if m.native != nil {
+		return m.native.source, m.native.destination
+	}
+	return "", ""
+}
+
+// Native RPC replay and RC submission share admission. No job can reserve a
+// prefix while another is checking its conflict set. Provider work is outside this lock.
+func (v *VFS) admitNative(source, dest, request string, exclusive bool) (string, error) {
+	if !exclusive {
+		source = strings.Trim(source, "/")
+		dest = strings.Trim(dest, "/")
+	}
+	if !movePath(source) || !movePath(dest) || source == dest && exclusive {
+		return "", syscall.EINVAL
+	}
+	v.ensureMoveRegistry()
+	v.moveAdmission.Lock()
+	defer v.moveAdmission.Unlock()
+	return v.admitLocked(source, dest, request, exclusive, false, nil)
+}
+func (v *VFS) admitLocked(source, dest, request string, exclusive, checked bool, preflightErr error) (string, error) {
+	if v.writerConflict(source, dest, exclusive) {
+		return "", syscall.EBUSY
+	}
+	var free, matched *safeMoveState
+	for _, m := range v.slots() {
+		m.mu.Lock()
+		v.loadMoveAt(m)
+		if m.loadError != nil {
+			m.mu.Unlock()
+			return "", syscall.EIO
+		}
+		if exclusive {
+			if n := m.native; n != nil && n.requestID == request {
+				if n.source != source || n.destination != dest {
+					m.mu.Unlock()
+					return "", syscall.EINVAL
+				}
+				id, e := n.id, n.err
+				m.mu.Unlock()
+				return id, e
+			}
+			if j := m.journal; j != nil && j.RequestID == request {
+				if j.Source != source || j.Destination != dest {
+					m.mu.Unlock()
+					return "", syscall.EINVAL
+				}
+				id := j.ID
+				failed := j.Failed
+				m.mu.Unlock()
+				if failed {
+					return "", errMovePreflight
+				}
+				return id, nil
+			}
+		}
+		for _, n := range m.nativeHistory {
+			if exclusive && n.requestID == request && (n.source != source || n.destination != dest) {
+				m.mu.Unlock()
+				return "", syscall.EINVAL
+			}
+			if n.source == source && n.destination == dest && ((request != "" && request == n.requestID) || (!exclusive && n.pathValid && (request != "" || n.epoch == m.epoch))) {
+				m.replayed = true
+				m.mu.Unlock()
+				return n.id, nil
+			}
+		}
+		busy := m.busy()
+		s, d := m.endpoints()
+		if (busy || m.pending) && v.scopesIntersect(source, dest, exclusive, s, d, m.exclusiveJob()) {
+			if busy {
+				m.mu.Unlock()
+				return "", syscall.EBUSY
+			}
+			if m.native != nil && m.native.source == source && m.native.destination == dest && !exclusive {
+				matched = m
+			} else {
+				m.mu.Unlock()
+				return "", syscall.EIO
+			}
+		}
+		if !exclusive && m.journal != nil && m.journal.Complete && m.journal.Source == source && m.journal.Destination == dest && !m.busy() {
+			matched = m
+		}
+		if n := m.native; n != nil && n.done && n.err != nil && n.source == source && n.destination == dest && !exclusive {
+			matched = m
+		}
+		if free == nil && !busy && !m.pending {
+			free = m
+		}
+		m.mu.Unlock()
+	}
+	if matched != nil {
+		free = matched
+	}
+	if free == nil {
+		return "", syscall.EBUSY
+	}
+	if exclusive && !checked {
+		v.moveAdmission.Unlock()
+		err := v.preflightExclusive(source, dest)
+		v.moveAdmission.Lock()
+		// A matching request could have reserved the move during remote checks.
+		return v.admitLocked(source, dest, request, true, true, err)
+	}
+	if preflightErr != nil {
+		return "", preflightErr
+	}
+
+	for _, m := range v.slots() {
+		m.mu.Lock()
+		v.expireMovePaths(m, source)
+		v.expireMovePaths(m, dest)
+		m.mu.Unlock()
+	}
+	err := v.startNative(free, source, dest, request, exclusive)
+	free.mu.Lock()
+	defer free.mu.Unlock()
+	if exclusive && errors.Is(err, syscall.EBUSY) && free.native != nil && free.native.requestID == request {
+		return free.native.id, nil
+	}
+	return "", err
+}
+
+func (v *VFS) LockMoveMutation() (func(), error) {
+	v.ensureMoveRegistry()
+	slots := v.slots()
+	held := 0
+	release := func() {
+		for i := held - 1; i >= 0; i-- {
+			slots[i].gate.RUnlock()
+		}
+	}
+	for _, m := range slots {
+		if !m.gate.TryRLock() {
+			release()
+			return nil, syscall.EBUSY
+		}
+		held++
+		m.mu.Lock()
+		v.loadMoveAt(m)
+		busy, failed := m.busy(), m.pending || m.loadError != nil
+		if !busy && !failed {
+			m.epoch++
+		}
+		m.mu.Unlock()
+		if busy || failed {
+			release()
+			if busy {
+				return nil, syscall.EBUSY
+			}
+			return nil, syscall.EIO
+		}
+	}
+	return release, nil
+}
+
+func (v *VFS) MoveStatus() rc.Params {
+	v.ensureMoveRegistry()
+	slots := v.slots()
+	for _, m := range slots {
+		m.mu.Lock()
+		defer m.mu.Unlock()
+	}
+	jobs := []rc.Params{}
+	selected := -1
+	status := rc.Params{"version": 1, "enabled": v.Opt.MoveJournal != "", "active": false, "needsRecovery": false, "phase": "idle", "completed": 0, "total": 0, "message": ""}
+	for i, m := range slots {
+		v.loadMoveAt(m)
+		if m.native == nil && m.journal == nil && m.loadError == nil && !m.active && m.phase == "" {
+			continue
+		}
+		active := m.busy()
+		recover := !active && (m.pending || m.loadError != nil)
+		phase := m.phase
+		src, dst := m.endpoints()
+		id := fmt.Sprintf("invalid-%d", i)
+		if m.native != nil && (m.busy() || !m.pending) {
+			src, dst = m.native.source, m.native.destination
+			id = m.native.id
+		} else if m.journal != nil {
+			id = m.journal.ID
+		}
+		if m.loadError != nil {
+			src, dst = "", ""
+			id = fmt.Sprintf("invalid-%d", i)
+		}
+		if recover {
+			phase = "needsRecovery"
+		}
+		if active && phase != "preparing" && phase != "copying" && phase != "verifying" && phase != "removing" {
+			phase = "preparing"
+		}
+		j := rc.Params{"id": id, "source": src, "destination": dst, "active": active, "needsRecovery": recover, "phase": phase, "completed": m.completed, "total": m.total, "message": m.problem}
+		if m.journal != nil && m.journal.Failed && id == m.journal.ID {
+			j["failureKind"] = m.journal.FailureKind
+		}
+		jobs = append(jobs, j)
+		priority := 0
+		if phase == "failed" {
+			priority = 1
+		}
+		if recover {
+			priority = 2
+			status["needsRecovery"] = true
+		}
+		if active {
+			priority = 3
+			status["active"] = true
+		}
+		if priority > selected {
+			selected = priority
+			for _, k := range []string{"phase", "completed", "total", "message"} {
+				status[k] = j[k]
+			}
+		}
+	}
+	status["jobs"] = jobs
+	return status
+}
+func (v *VFS) ResumeMove() error { return v.resumeMoveID("") }
+func (v *VFS) resumeMoveID(id string) error {
+	if v.Opt.ReadOnly || v.Opt.MoveJournal == "" {
+		return syscall.EROFS
+	}
+	v.ensureMoveRegistry()
+	v.moveAdmission.Lock()
+	defer v.moveAdmission.Unlock()
+	var candidate *safeMoveState
+	type pair struct {
+		s, d      string
+		exclusive bool
+	}
+	var reserved []pair
+	for _, m := range v.slots() {
+		m.mu.Lock()
+		v.loadMoveAt(m)
+		if m.loadError != nil {
+			m.mu.Unlock()
+			return syscall.EIO
+		}
+		if m.pending || m.busy() {
+			s, d := m.endpoints()
+			for _, p := range reserved {
+				if v.scopesIntersect(s, d, m.exclusiveJob(), p.s, p.d, p.exclusive) {
+					m.mu.Unlock()
+					return fmt.Errorf("overlapping recovery records")
+				}
+			}
+			reserved = append(reserved, pair{s, d, m.exclusiveJob()})
+		}
+		if candidate == nil && m.pending && !m.busy() && m.journal != nil && (id == "" || id == m.journal.ID) {
+			candidate = m
+		}
+		m.mu.Unlock()
+	}
+	if candidate != nil {
+		candidate.mu.Lock()
+		s, d := candidate.endpoints()
+		exclusive := candidate.exclusiveJob()
+		candidate.mu.Unlock()
+		if v.writerConflict(s, d, exclusive) {
+			return syscall.EBUSY
+		}
+	}
+	if candidate == nil {
+		return fmt.Errorf("no matching resumable move")
+	}
+	return v.resumeSlot(candidate)
+}
+func init() {
+	rc.Add(rc.Call{Path: "vfs/move", NoAuth: false, Title: "Submit a non-overwriting native move.", Fn: func(ctx context.Context, in rc.Params) (rc.Params, error) {
+		v, e := getVFS(in)
+		if e != nil {
+			return nil, e
+		}
+		if v.Opt.MoveJournal == "" || v.Opt.ReadOnly {
+			return nil, syscall.EROFS
+		}
+		s, e := in.GetString("source")
+		if e != nil {
+			return nil, e
+		}
+		d, e := in.GetString("destination")
+		if e != nil {
+			return nil, e
+		}
+		request, e := in.GetString("requestID")
+		if e != nil || len(request) < 1 || len(request) > 128 || strings.ContainsAny(request, "/\\\x00") {
+			return nil, syscall.EINVAL
+		}
+		if filepath.IsAbs(s) || filepath.IsAbs(d) || intersect(v.normMove(s), v.normMove(d)) || (!strings.HasPrefix(path.Base(s), "._") && strings.HasPrefix(path.Base(d), "._")) {
+			return nil, syscall.EINVAL
+		}
+		id, e := v.admitNative(s, d, "rc:"+request, true)
+		return moveSubmissionReply(id, e)
+	}})
+}
+func moveSubmissionReply(id string, e error) (rc.Params, error) {
+	if id == "" && errors.Is(e, syscall.EEXIST) {
+		return rc.Params{"accepted": false, "reason": "destinationExists"}, nil
+	}
+	if id == "" && errors.Is(e, syscall.EBUSY) {
+		return rc.Params{"accepted": false, "reason": "busy"}, nil
+	}
+	if e != nil {
+		return nil, e
+	}
+	return rc.Params{"accepted": true, "id": id}, nil
+}
+
+type exclusiveMoveCopier interface {
+	CheckExclusiveMoveCopy(size int64) error
+	CopyExclusiveMove(context.Context, fs.Object, string, string) (fs.Object, error)
+	VerifyExclusiveMove(context.Context, fs.Object, string, string) error
+}
+
+func (v *VFS) writerConflict(s, d string, exclusive bool) bool {
+	for name := range v.moveWriters {
+		if v.scopesIntersect(name, name, false, s, d, exclusive) {
+			return true
+		}
+	}
+	return false
+}
+func (v *VFS) LockMoveMutationPath(name string) (func(), error) {
+	name = strings.Trim(name, "/")
+	if !movePath(name) {
+		return v.LockMoveMutation()
+	}
+	v.ensureMoveRegistry()
+	v.moveAdmission.Lock()
+	defer v.moveAdmission.Unlock()
+	for _, m := range v.slots() {
+		m.mu.Lock()
+		v.loadMoveAt(m)
+		busy := m.busy()
+		pending := m.pending
+		corrupt := m.loadError != nil
+		s, d := m.endpoints()
+		if corrupt || ((busy || pending) && v.scopesIntersect(name, name, false, s, d, m.exclusiveJob())) {
+			m.mu.Unlock()
+			if corrupt || !busy {
+				return nil, syscall.EIO
+			}
+			return nil, syscall.EBUSY
+		}
+		m.epoch++
+		m.mu.Unlock()
+	}
+	if v.moveWriters == nil {
+		v.moveWriters = make(map[string]int)
+	}
+	v.moveWriters[name]++
+	return func() {
+		v.moveAdmission.Lock()
+		defer v.moveAdmission.Unlock()
+		v.moveWriters[name]--
+		if v.moveWriters[name] == 0 {
+			delete(v.moveWriters, name)
+		}
+	}, nil
+}
+
+// Validate the complete record set before any recovered reservation can execute.
+// Slots never share a progress log, request identity, or unfinished endpoint.
+func (v *VFS) ensureMoveRegistry() {
+	v.moveLoadOnce.Do(func() {
+		slots := v.slots()
+		records := make([]*moveJournal, len(slots))
+		bad := map[int]bool{}
+		for i, m := range slots {
+			m.mu.Lock()
+			v.loadMoveAt(m)
+			records[i] = m.journal
+			m.mu.Unlock()
+		}
+		for i, j := range records {
+			if j == nil {
+				continue
+			}
+			for n, k := range records[:i] {
+				if k != nil && ((j.ID != "" && j.ID == k.ID) || (j.RequestID != "" && j.RequestID == k.RequestID) || (!j.Complete && !j.Failed && !k.Complete && !k.Failed && v.scopesIntersect(j.Source, j.Destination, j.Exclusive, k.Source, k.Destination, k.Exclusive))) {
+					bad[i] = true
+					bad[n] = true
+				}
+			}
+		}
+		for i := range bad {
+			m := slots[i]
+			m.mu.Lock()
+			m.loadError = fmt.Errorf("conflicting saved move records")
+			m.problem = "Saved move records conflict. Preserve them for recovery."
+			m.mu.Unlock()
+		}
+	})
+}
+
+var errMovePreflight = errors.New("unsupported or invalid move")
+
+const preflightFailureMessage = "Move could not start. Check file sizes, source and destination, then submit a new move."
+
+func (v *VFS) preflightExclusive(source, dest string) error {
+	a, ok := v.f.(exclusiveMoveCopier)
+	if !ok || v.f.Features().Move != nil || v.f.Features().DirMove != nil {
+		return fmt.Errorf("backend lacks guarded native copy")
+	}
+	if err := a.CheckExclusiveMoveCopy(0); err != nil {
+		return err
+	}
+	if _, err := v.Stat(dest); err == nil {
+		return syscall.EEXIST
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if _, err := v.Stat(source); err != nil {
+		return err
+	}
+	// The VFS cache may be stale. Check the authoritative parent directory too.
+	parent := path.Dir(dest)
+	if parent == "." {
+		parent = ""
+	}
+	return moveRequestError(v.ctx, moveMetadataTimeout, func(ctx context.Context) error {
+		list, err := v.f.List(ctx, parent)
+		if err != nil {
+			return err
+		}
+		for _, entry := range list {
+			_, td, ok := companionPair(source, dest)
+			if v.normMove(entry.Remote()) == v.normMove(dest) || (ok && v.normMove(td) == v.normMove(entry.Remote())) {
+				return syscall.EEXIST
+			}
+		}
+		return nil
+	})
+}
+
+func preflightKind(err error) string {
+	switch {
+	case errors.Is(err, syscall.EEXIST):
+		return "destinationExists"
+	case errors.Is(err, os.ErrNotExist):
+		return "missingPath"
+	case errors.Is(err, errMovePreflight):
+		return "unsupportedPayload"
+	default:
+		return "invalidPath"
+	}
+}
+func preflightMessage(kind string) string {
+	switch kind {
+	case "destinationExists":
+		return "The destination already exists. Choose a different name or folder."
+	case "missingPath":
+		return "The source or its destination folder is missing. Check both paths."
+	case "unsupportedPayload":
+		return "A file exceeds the protected copy limit or its format is unsupported."
+	default:
+		return preflightFailureMessage
+	}
+}
