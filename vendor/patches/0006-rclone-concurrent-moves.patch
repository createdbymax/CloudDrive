+package vfs
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"path"
+	"sort"
+	"strings"
+	"syscall"
+
+	"github.com/rclone/rclone/fs"
+)
+
+func companionPair(src, dst string) (string, string, bool) {
+	if strings.HasPrefix(path.Base(src), "._") || strings.HasPrefix(path.Base(dst), "._") {
+		return "", "", false
+	}
+	return path.Join(path.Dir(src), "._"+path.Base(src)), path.Join(path.Dir(dst), "._"+path.Base(dst)), true
+}
+
+// Reserve both potential sidecar paths before reading inventory. Finder may
+// create metadata while a folder is being prepared; an unrelated path stays writable.
+func moveEndpoints(src, dst string, exclusive bool) []string {
+	endpoints := []string{src, dst}
+	if a, b, ok := companionPair(src, dst); ok && exclusive {
+		return append(endpoints, a, b)
+	}
+	return endpoints
+}
+func (m *safeMoveState) exclusiveJob() bool {
+	if n := m.native; n != nil && !n.done {
+		return n.exclusive
+	}
+	return m.journal != nil && m.journal.Exclusive
+}
+func (v *VFS) scopesIntersect(src, dst string, exclusive bool, s, d string, otherExclusive bool) bool {
+	for _, left := range moveEndpoints(src, dst, exclusive) {
+		for _, right := range moveEndpoints(s, d, otherExclusive) {
+			if intersect(v.normMove(left), v.normMove(right)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+func (v *VFS) inMoveScope(name, src, dst string, exclusive bool) bool {
+	for _, root := range moveEndpoints(src, dst, exclusive) {
+		if v.within(name, root) {
+			return true
+		}
+	}
+	return false
+}
+
+const appleDoubleHeader = 26
+const maxAppleDoubleEntries = 256
+
+func validAppleDoubleHeader(data []byte, size int64) bool {
+	if len(data) < appleDoubleHeader || binary.BigEndian.Uint32(data) != 0x00051607 || binary.BigEndian.Uint32(data[4:]) != 0x00020000 {
+		return false
+	}
+	n := int(binary.BigEndian.Uint16(data[24:]))
+	table := appleDoubleHeader + 12*n
+	if n < 1 || n > maxAppleDoubleEntries || len(data) < table {
+		return false
+	}
+	ids := make(map[uint32]bool, n)
+	type extent struct{ start, end int64 }
+	var spans []extent
+	for i := 0; i < n; i++ {
+		entry := data[appleDoubleHeader+12*i:]
+		id := binary.BigEndian.Uint32(entry)
+		start := int64(binary.BigEndian.Uint32(entry[4:]))
+		end := start + int64(binary.BigEndian.Uint32(entry[8:]))
+		if id == 0 || ids[id] || start < int64(table) || end > size {
+			return false
+		}
+		ids[id] = true
+		if end > start {
+			spans = append(spans, extent{start, end})
+		}
+	}
+	sort.Slice(spans, func(i, j int) bool { return spans[i].start < spans[j].start })
+	for i := 1; i < len(spans); i++ {
+		if spans[i].start < spans[i-1].end {
+			return false
+		}
+	}
+	return true
+}
+func isAppleDouble(ctx context.Context, o fs.Object) (bool, error) {
+	size := o.Size()
+	if size < 0 {
+		return false, fmt.Errorf("unknown sidecar size")
+	}
+	if size < appleDoubleHeader {
+		return false, nil
+	}
+	n := min(size, int64(appleDoubleHeader+12*maxAppleDoubleEntries))
+	r, e := o.Open(ctx, &fs.RangeOption{Start: 0, End: n - 1})
+	if e != nil {
+		return false, e
+	}
+	data := make([]byte, n)
+	_, e = io.ReadFull(r, data)
+	closeErr := r.Close()
+	if e != nil {
+		return false, e
+	}
+	if closeErr != nil {
+		return false, closeErr
+	}
+	return validAppleDoubleHeader(data, size), nil
+}
+func (v *VFS) inventoryCompanion(ctx context.Context, j *moveJournal) error {
+	s, d, ok := companionPair(j.Source, j.Destination)
+	if !j.Exclusive || !ok {
+		return nil
+	}
+	return moveRequestError(ctx, moveMetadataTimeout, func(ctx context.Context) error {
+		// Recheck after submission, including when replaying a preparation intent.
+		if _, e := v.f.NewObject(ctx, d); e == nil || errors.Is(e, fs.ErrorIsDir) {
+			return syscall.EEXIST
+		} else if !errors.Is(e, fs.ErrorObjectNotFound) {
+			return e
+		}
+		o, e := v.f.NewObject(ctx, s)
+		if errors.Is(e, fs.ErrorObjectNotFound) || errors.Is(e, fs.ErrorIsDir) {
+			return nil
+		}
+		if e != nil {
+			return e
+		}
+		valid, e := isAppleDouble(ctx, o)
+		if e != nil || !valid {
+			return e
+		}
+		if len(j.Objects) >= moveObjectLimit {
+			return fmt.Errorf("too many objects in move")
+		}
+		j.AppleDouble = true
+		j.Objects = append(j.Objects, moveObject{Source: s, Destination: d})
+		return nil
+	})
+}
+func (j *moveJournal) isCompanion(r moveObject) bool {
+	s, d, ok := companionPair(j.Source, j.Destination)
+	return j.Exclusive && j.AppleDouble && ok && r.Source == s && r.Destination == d
+}
+
+// Invalidate the two parent listings even if no sidecar was present. A
+// provider-side RC move does not have a Finder RENAME reply to update listings.
+func (v *VFS) publishMoveCache(j *moveJournal, m *safeMoveState) error {
+	if !j.Exclusive {
+		return nil
+	}
+	if j.AppleDouble {
+		s, d, ok := companionPair(j.Source, j.Destination)
+		if !ok {
+			return fmt.Errorf("invalid sidecar paths")
+		}
+		if e := publishHandleRename(m, &j.companionHandlesPublished, s, d); e != nil {
+			return e
+		}
+		v.noteMetadataChange(s, false)
+		v.noteMetadataChange(d, false)
+	}
+	for _, key := range moveEndpoints(j.Source, j.Destination, true) {
+		v.root.ForgetPath(key, fs.EntryObject)
+	}
+	return nil
+}
+
+func publishHandleRename(m *safeMoveState, published *bool, source, dest string) error {
+	if *published || m.onResume == nil {
+		return nil
+	}
+	if err := m.onResume(source, dest); err != nil {
+		return err
+	}
+	*published = true
+	return nil
+}
+
+// Perform provider reads and cache file I/O before the NFS namespace commit.
+// Recheck the receipt even if this is a resume after all deletes were synced.
+func (v *VFS) prepareCompanionCache(ctx context.Context, j *moveJournal) error {
+	if !j.AppleDouble {
+		return nil
+	}
+	for i := range j.Objects {
+		r := &j.Objects[i]
+		if !j.isCompanion(*r) {
+			continue
+		}
+		obj, err := moveRequest(ctx, moveMetadataTimeout, func(ctx context.Context) (fs.Object, error) {
+			dst, err := v.f.NewObject(ctx, r.Destination)
+			if err != nil {
+				return nil, err
+			}
+			if !v.destinationMatches(ctx, dst, r) {
+				return nil, fmt.Errorf("destination sidecar changed before cache publication")
+			}
+			return dst, nil
+		})
+		if err != nil {
+			return err
+		}
+		if v.cache != nil && v.cache.Exists(r.Source) {
+			return v.cache.Rename(r.Source, r.Destination, obj)
+		}
+		return nil
+	}
+	return fmt.Errorf("missing sidecar receipt")
+}
