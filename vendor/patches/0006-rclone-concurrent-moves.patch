+func TestNativeMoveConcurrentCopySharedParentAndIndependentRecovery(t *testing.T) {
+	v, f := moveFixture(t)
+	v.Opt.CaseInsensitive = true
+	for _, k := range []string{"Café/a", "Second/b", "Target/keep", "Other/file"} {
+		movePut(t, f, k, k)
+	}
+	copyFn := f.Features().Copy
+	entered := make(chan string, 2)
+	release := make(chan struct{})
+	f.Features().Copy = func(ctx context.Context, o fs.Object, dest string) (fs.Object, error) {
+		entered <- dest
+		select {
+		case <-release:
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+		return nil, errors.New("fixture stopped both copies")
+	}
+	require.ErrorIs(t, v.RenameNativeRequest("Café", "Target/Café", "n1"), syscall.EBUSY)
+	require.Eventually(t, func() bool { return len(entered) == 1 }, 3*time.Second, time.Millisecond*5)
+	require.ErrorIs(t, v.RenameNativeRequest("Second", "Target/Second", "n2"), syscall.EBUSY)
+	require.Eventually(t, func() bool { return len(entered) == 2 }, 3*time.Second, time.Millisecond*5)
+	status := v.MoveStatus()
+	jobs := status["jobs"].([]rc.Params)
+	require.Len(t, jobs, 2)
+	for _, j := range jobs {
+		require.True(t, j["active"].(bool))
+	}
+	for _, p := range []string{"cafe\u0301/a", "TARGET", "target/second/b"} {
+		_, e := v.LockMoveMutationPath(p)
+		require.ErrorIs(t, e, syscall.EBUSY)
+	}
+	lease, e := v.LockMoveMutationPath("Other/new")
+	require.NoError(t, e)
+	require.ErrorIs(t, v.RenameNativeRequest("Other", "Target/Other", "writer"), syscall.EBUSY)
+	lease()
+	require.ErrorIs(t, v.RenameNativeRequest("cafe\u0301", "Else", "n3"), syscall.EBUSY)
+	require.Len(t, v.MoveStatus()["jobs"].([]rc.Params), 2)
+	close(release)
+	finishJobs(t, v)
+	require.FileExists(t, filepath.Join(v.Opt.MoveJournal, "move.json"))
+	require.FileExists(t, filepath.Join(v.Opt.MoveJournal, "move-1.json"))
+	require.Equal(t, true, v.MoveStatus()["needsRecovery"])
+	f.Features().Copy = copyFn
+	fresh := &VFS{ctx: v.ctx, f: f, root: v.root, Opt: v.Opt}
+	require.Error(t, fresh.resumeMoveID("stale"))
+	fresh.Opt.ReadOnly = true
+	require.Error(t, fresh.resumeMoveID(jobs[1]["id"].(string)))
+	fresh.Opt.ReadOnly = false
+	require.NoError(t, fresh.resumeMoveID(jobs[1]["id"].(string)))
+	finishJobs(t, fresh)
+	moveExists(t, f, "Café/a", true)
+	moveExists(t, f, "Second/b", false)
+	moveExists(t, f, "Target/Second/b", true)
+	require.Equal(t, true, fresh.MoveStatus()["needsRecovery"])
+	require.NoError(t, fresh.ResumeMove())
+	finishJobs(t, fresh)
+	moveExists(t, f, "Target/Café/a", true)
+	require.Equal(t, false, fresh.MoveStatus()["needsRecovery"])
+}
