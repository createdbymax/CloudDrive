+func TestNativeMoveCompanionPublicationAllowsBrowsingAndResumesHandlesOnce(t *testing.T) {
+	v, f := moveFixture(t)
+	movePut(t, f, "Primary", "main")
+	movePut(t, f, "._Primary", sidecarBytes())
+	movePut(t, f, "Target/keep", "original")
+	remote := &blockedPublicationFS{exclusiveFixture: &exclusiveFixture{Fs: f, receipts: map[string]string{}}, entered: make(chan struct{}), release: make(chan struct{})}
+	v.f = remote
+	var namespace sync.Mutex
+	v.SetMoveNamespaceLocker(func() func() { namespace.Lock(); return namespace.Unlock })
+	calls := map[string]int{}
+	record := filepath.Join(v.Opt.MoveJournal, "move.json")
+	v.SetMoveHandleRenamer(func(s, d string) error {
+		calls[s]++
+		if s == "._Primary" && calls[s] == 1 {
+			if err := os.Rename(record, record+".saved"); err != nil {
+				return err
+			}
+			return os.Mkdir(record, 0700) // Force the following atomic journal replacement to fail.
+		}
+		return nil
+	})
+	id, e := v.admitNative("Primary", "Target/Renamed", "rc:publish", true)
+	require.NoError(t, e)
+	select {
+	case <-remote.entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("did not reach bounded post-delete lookup")
+	}
+	available := namespace.TryLock()
+	if available {
+		namespace.Unlock()
+	}
+	close(remote.release)
+	require.True(t, available, "unrelated Finder requests must proceed while provider lookup is blocked")
+	finishJobs(t, v)
+	require.Equal(t, true, v.MoveStatus()["needsRecovery"])
+	require.Equal(t, map[string]int{"Primary": 1, "._Primary": 1}, calls)
+	require.NoError(t, os.Remove(record))
+	require.NoError(t, os.Rename(record+".saved", record))
+	require.NoError(t, v.resumeMoveID(id))
+	finishJobs(t, v)
+	require.Equal(t, false, v.MoveStatus()["needsRecovery"])
+	require.Equal(t, map[string]int{"Primary": 1, "._Primary": 1}, calls)
+	moveExists(t, f, "Target/Renamed", true)
+	moveExists(t, f, "Target/._Renamed", true)
+}
