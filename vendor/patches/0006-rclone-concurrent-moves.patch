+// Isolated fake of the provider's exclusive-copy contract.
+type exclusiveFixture struct {
+	fs.Fs
+	mu       sync.Mutex
+	receipts map[string]string
+}
+
+func (f *exclusiveFixture) CheckExclusiveMoveCopy(int64) error { return nil }
+func (f *exclusiveFixture) CopyExclusiveMove(ctx context.Context, src fs.Object, dst, job string) (fs.Object, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if o, e := f.NewObject(ctx, dst); e == nil {
+		if f.receipts[dst] == job {
+			return o, nil
+		}
+		return nil, syscall.EEXIST
+	}
+	o, e := f.Features().Copy(ctx, src, dst)
+	if e == nil {
+		f.receipts[dst] = job
+	}
+	return o, e
+}
+func (f *exclusiveFixture) VerifyExclusiveMove(ctx context.Context, src fs.Object, dst, job string) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.receipts[dst] != job {
+		return syscall.EEXIST
+	}
+	return nil
+}
+func TestNativeMoveDurableExclusiveAdmissionAndRestart(t *testing.T) {
+	v, f := moveFixture(t)
+	movePut(t, f, "A/file", "payload")
+	movePut(t, f, "Target/keep", "keep")
+	v.f = &exclusiveFixture{Fs: f, receipts: map[string]string{}}
+	// Simulate the window immediately after admission fsync, before any planning.
+	v.safeMoves.gate.Lock()
+	id, e := v.admitNative("A", "Target/A", "rc:request", true)
+	require.NoError(t, e)
+	again, e := v.admitNative("A", "Target/A", "rc:request", true)
+	require.NoError(t, e)
+	require.Equal(t, id, again)
+	_, e = v.admitNative("A", "Target/other", "rc:request", true)
+	require.ErrorIs(t, e, syscall.EINVAL)
+	_, e = v.admitNative("Target/keep", "A/file", "rc:conflict", true)
+	require.Error(t, e)
+	// Snapshot crash state to a distinct private directory; never run two workers against one journal.
+	data, e := os.ReadFile(filepath.Join(v.Opt.MoveJournal, "move.json"))
+	require.NoError(t, e)
+	alt := t.TempDir()
+	require.NoError(t, os.Chmod(alt, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(alt, "move.json"), data, 0600))
+	copyFn := f.Features().Copy
+	f.Features().Copy = func(context.Context, fs.Object, string) (fs.Object, error) { return nil, errors.New("injected") }
+	v.safeMoves.gate.Unlock()
+	finishJobs(t, v)
+	f.Features().Copy = copyFn
+	opt := v.Opt
+	opt.MoveJournal = alt
+	fresh := New(v.ctx, v.f, &opt)
+	t.Cleanup(fresh.Shutdown)
+	require.Equal(t, true, fresh.MoveStatus()["needsRecovery"])
+	repeated, e := fresh.admitNative("A", "Target/A", "rc:request", true)
+	require.NoError(t, e)
