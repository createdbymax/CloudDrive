+func TestNativeMoveAppleDoubleGuardAndRecovery(t *testing.T) {
+	v, f := moveFixture(t)
+	movePut(t, f, "Primary/data", "user bytes")
+	movePut(t, f, "Target/keep", "old")
+	movePut(t, f, "._Primary", sidecarBytes())
+	movePut(t, f, "Target/._Renamed", "prior target")
+	v.f = &exclusiveFixture{Fs: f, receipts: map[string]string{}}
+	_, e := v.admitNative("Primary", "Target/Renamed", "rc:collision", true)
+	require.ErrorIs(t, e, syscall.EEXIST)
+	moveExists(t, f, "Primary/data", true)
+	moveExists(t, f, "._Primary", true)
+	dst, e := f.NewObject(v.ctx, "Target/._Renamed")
+	require.NoError(t, e)
+	require.NoError(t, dst.Remove(v.ctx))
+	releaseWriter, e := v.LockMoveMutationPath("._Primary")
+	require.NoError(t, e)
+	_, e = v.admitNative("Primary", "Target/Renamed", "rc:busy", true)
+	require.ErrorIs(t, e, syscall.EBUSY)
+	releaseWriter()
+	blocked, proceed := make(chan struct{}), make(chan struct{})
+	copyFn := f.Features().Copy
+	f.Features().Copy = func(ctx context.Context, o fs.Object, dst string) (fs.Object, error) {
+		if dst == "Target/._Renamed" {
+			close(blocked)
+			<-proceed
+			return nil, errors.New("fixture interruption")
+		}
+		return copyFn(ctx, o, dst)
+	}
+	id, e := v.admitNative("Primary", "Target/Renamed", "rc:metadata", true)
+	require.NoError(t, e)
+	select {
+	case <-blocked:
+	case <-time.After(2 * time.Second):
+		t.Fatal("companion copy was not reached")
+	}
+	for _, k := range []string{"._Primary", "Target/._Renamed"} {
+		_, e := v.LockMoveMutationPath(k)
+		require.ErrorIs(t, e, syscall.EBUSY)
+		require.ErrorIs(t, v.CheckMovePath(k), syscall.EBUSY)
+		_, e = v.admitNative(k, "Other", "rc:other", true)
+		require.ErrorIs(t, e, syscall.EBUSY)
+	}
+	close(proceed)
+	finishJobs(t, v)
+	require.Equal(t, true, v.MoveStatus()["needsRecovery"])
+	moveExists(t, f, "Primary/data", true)
+	moveExists(t, f, "._Primary", true)
+	f.Features().Copy = copyFn
+	fresh := &VFS{ctx: v.ctx, f: v.f, root: v.root, Opt: v.Opt}
+	require.NoError(t, fresh.resumeMoveID(id))
+	finishJobs(t, fresh)
+	require.Equal(t, false, fresh.MoveStatus()["needsRecovery"])
+	moveExists(t, f, "._Primary", false)
+	moveExists(t, f, "Target/._Renamed", true)
+	moveExists(t, f, "Target/Renamed/data", true)
+}
