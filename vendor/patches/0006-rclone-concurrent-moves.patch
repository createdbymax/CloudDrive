+type blockedPublicationFS struct {
+	*exclusiveFixture
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (f *blockedPublicationFS) NewObject(ctx context.Context, key string) (fs.Object, error) {
+	if key == "Target/._Renamed" {
+		_, sourceErr := f.Fs.NewObject(ctx, "Primary")
+		_, sideErr := f.Fs.NewObject(ctx, "._Primary")
+		if errors.Is(sourceErr, fs.ErrorObjectNotFound) && errors.Is(sideErr, fs.ErrorObjectNotFound) {
+			if _, ok := ctx.Deadline(); !ok {
+				return nil, errors.New("unbounded post-delete sidecar lookup")
+			}
+			f.once.Do(func() { close(f.entered) })
+			select {
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			case <-f.release:
+			}
+		}
+	}
+	return f.Fs.NewObject(ctx, key)
+}
