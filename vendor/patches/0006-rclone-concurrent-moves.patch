+	require.NoError(t, fresh.resumeMoveID(id))
+	finishJobs(t, fresh)
+	require.Equal(t, false, fresh.MoveStatus()["needsRecovery"])
+	moveExists(t, f, "A/file", false)
+	moveExists(t, f, "Target/A/file", true)
+}
