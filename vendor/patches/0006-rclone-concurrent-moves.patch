+func sidecarBytes() string {
+	b := make([]byte, 45)
+	binary.BigEndian.PutUint32(b, 0x51607)
+	binary.BigEndian.PutUint32(b[4:], 0x20000)
+	binary.BigEndian.PutUint16(b[24:], 1)
+	binary.BigEndian.PutUint32(b[26:], 2)
+	binary.BigEndian.PutUint32(b[30:], 38)
+	binary.BigEndian.PutUint32(b[34:], 7)
+	copy(b[38:], "uniquef")
+	return string(b)
+}
+func TestNativeMoveAppleDouble(t *testing.T) {
+	for _, folder := range []bool{true, false} {
+		for _, valid := range []bool{true, false} {
+			v, f := moveFixture(t)
+			key := "Primary"
+			end := "Target/Renamed"
+			if folder {
+				key += "/data"
+				end += "/data"
+			}
+			movePut(t, f, key, "user bytes")
