+// Modified for CloudDrive: serialize same-parent NFS create admission and validate exclusive replay.
+package nfs
+
+import (
+	"errors"
+	"os"
+	"sync"
+
+	"github.com/go-git/go-billy/v5"
+	nfsfile "github.com/willscott/go-nfs/file"
+)
+
+// Every request for an equivalent name in the same directory uses the same lock,
+// including GUARDED, UNCHECKED and MKDIR. Data writes and lookups do not take it.
+type createGate struct {
+	parents  [64]sync.Mutex
+	mu       sync.Mutex
+	receipts [1024]createReceipt
+	next     uint32
+}
+
+type createReceipt struct {
+	path     string
+	verifier [8]byte
+	inode    uint64
+}
+
+func createInode(info os.FileInfo) uint64 {
+	if attr := nfsfile.GetInfo(info); attr != nil {
+		return attr.Fileid
+	}
+	return 0
+}
+
+func (g *createGate) lockParent(fs billy.Filesystem, parent string) (func(), error) {
+	info, err := fs.Stat(parent)
+	if err != nil {
+		return nil, &NFSStatusError{NFSStatusAccess, err}
+	}
+	if !info.IsDir() {
+		return nil, &NFSStatusError{NFSStatusNotDir, nil}
+	}
+	lock := &g.parents[createInode(info)%uint64(len(g.parents))]
+	lock.Lock()
+	return lock.Unlock, nil
+}
+
+func (g *createGate) matches(receipt createReceipt) bool {
+	if receipt.inode == 0 {
+		return false
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	for _, entry := range g.receipts {
+		if entry == receipt {
+			return true
+		}
+	}
+	return false
+}
+
+func (g *createGate) remember(receipt createReceipt) {
+	if receipt.inode == 0 {
+		return
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.receipts[g.next] = receipt
+	g.next = (g.next + 1) % uint32(len(g.receipts))
+}
+
+// The verifier identifies the client's logical exclusive request across TCP retries.
+// Eviction, worker restart, or a new inode fails closed with EXIST on an occupied path.
+
+func (g *createGate) makeFile(fs billy.Filesystem, parent, name string, how uint32, verifier [8]byte) error {
+	unlock, err := g.lockParent(fs, parent)
+	if err != nil {
+		return err
+	}
+	defer unlock()
+	info, err := fs.Lstat(name)
+	if err == nil {
+		if !info.Mode().IsRegular() {
+			return &NFSStatusError{NFSStatusExist, os.ErrExist}
+		}
+		// The caller applies the requested attributes, including any explicit size.
+		if how == createModeUnchecked {
+			return nil
+		}
+		if how == createModeExclusive && g.matches(createReceipt{name, verifier, createInode(info)}) {
+			return nil
+		}
+		return &NFSStatusError{NFSStatusExist, os.ErrExist}
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		return &NFSStatusError{NFSStatusAccess, err}
+	}
+	fd, err := fs.OpenFile(name, os.O_CREATE|os.O_EXCL|os.O_RDWR, 0666)
+	if errors.Is(err, os.ErrExist) {
+		return &NFSStatusError{NFSStatusExist, err}
+	}
+	if err != nil {
+		return &NFSStatusError{NFSStatusAccess, err}
+	}
+	if err = fd.Close(); err != nil {
+		return &NFSStatusError{NFSStatusIO, err}
+	}
+	if how == createModeExclusive {
+		info, err = fs.Lstat(name)
+		if err != nil {
+			return &NFSStatusError{NFSStatusIO, err}
+		}
+		g.remember(createReceipt{name, verifier, createInode(info)})
+	}
+	return nil
+}
+
+func (g *createGate) makeDirectory(fs billy.Filesystem, parent, name string, perm os.FileMode) error {
+	unlock, err := g.lockParent(fs, parent)
+	if err != nil {
+		return err
+	}
+	defer unlock()
+	_, err = fs.Lstat(name)
+	if err == nil {
+		return &NFSStatusError{NFSStatusExist, os.ErrExist}
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		return &NFSStatusError{NFSStatusAccess, err}
+	}
+	if err = fs.MkdirAll(name, perm); err != nil {
+		return &NFSStatusError{NFSStatusAccess, err}
+	}
+	return nil
+}
