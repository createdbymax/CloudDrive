+package nfs
+
+import (
+	"errors"
+	"github.com/go-git/go-billy/v5/osfs"
+	"os"
+	"sync"
+	"testing"
+)
+
+func TestExclusiveAdmission(t *testing.T) {
+	for _, dir := range []bool{false, true} {
+		fs := osfs.New(t.TempDir())
+		var gate createGate
+		start := make(chan struct{})
+		results := make(chan error, 32)
+		for i := 0; i < 32; i++ {
+			i := i
+			go func() {
+				<-start
+				if dir {
+					results <- gate.makeDirectory(fs, ".", "item", 0755)
+				} else {
+					results <- gate.makeFile(fs, ".", "item", createModeExclusive, [8]byte{byte(i)})
+				}
+			}()
+		}
+		close(start)
+		wins := 0
+		for i := 0; i < 32; i++ {
+			err := <-results
+			if err == nil {
+				wins++
+			} else if !errors.Is(err, os.ErrExist) {
+				t.Fatal(err)
+			}
+		}
+		if wins != 1 {
+			t.Fatalf("dir %v winners %d", dir, wins)
+		}
+	}
+}
+func TestExclusiveReplay(t *testing.T) {
+	root := t.TempDir()
+	fs := osfs.New(root)
+	var g createGate
+	verifier := [8]byte{42}
+	if err := g.makeFile(fs, ".", "item", createModeExclusive, verifier); err != nil {
+		t.Fatal(err)
+	}
+	write := func(contents string) {
+		t.Helper()
+		if err := os.WriteFile(root+"/item", []byte(contents), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("original")
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if err := g.makeFile(fs, ".", "item", createModeExclusive, verifier); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wg.Wait()
+	for _, row := range []struct {
+		mode     uint32
+		verifier [8]byte
+	}{{createModeGuarded, verifier}, {createModeExclusive, [8]byte{1}}} {
+		if err := g.makeFile(fs, ".", "item", row.mode, row.verifier); !errors.Is(err, os.ErrExist) {
+			t.Fatal(err)
+		}
+	}
+	if err := g.makeFile(fs, ".", "item", createModeUnchecked, verifier); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(root + "/item")
+	if err != nil || string(b) != "original" {
+		t.Fatal(err, string(b))
+	}
+	if err := os.Rename(root+"/item", root+"/old"); err != nil {
+		t.Fatal(err)
+	}
+	write("new owner")
+	if err := g.makeFile(fs, ".", "item", createModeExclusive, verifier); !errors.Is(err, os.ErrExist) {
+		t.Fatal(err)
+	}
+	if err := g.makeDirectory(fs, ".", "item", 0755); !errors.Is(err, os.ErrExist) {
+		t.Fatal(err)
+	}
+}
