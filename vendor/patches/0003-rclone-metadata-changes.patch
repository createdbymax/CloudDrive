@@ -0,0 +1,63 @@
+package vfs
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestMetadataChangesRetentionAndSession(t *testing.T) {
+	var v VFS
+	empty := v.readMetadataChanges(0, 10)
+	require.NotEmpty(t, empty["session"])
+	for i := 0; i < metadataChangeRetention+5; i++ {
+		v.noteMetadataChange(fmt.Sprintf("file%d", i), false)
+	}
+	page := v.readMetadataChanges(0, 2)
+	require.Equal(t, true, page["gap"])
+	require.Equal(t, uint64(6), page["first"])
+	events := page["events"].([]metadataChange)
+	require.Len(t, events, 2)
+	require.Equal(t, uint64(6), events[0].Sequence)
+	require.Equal(t, empty["session"], page["session"])
+	last := v.readMetadataChanges(uint64(metadataChangeRetention+5), 10)
+	require.Empty(t, last["events"])
+	require.Equal(t, false, last["hasMore"])
+	var replacement VFS
+	require.NotEqual(t, empty["session"], replacement.readMetadataChanges(0, 1)["session"])
+	require.Equal(t, true, replacement.readMetadataChanges(500, 1)["gap"])
+}
+
+func TestMetadataChangesConcurrentReadersAndWriters(t *testing.T) {
+	var v VFS
+	var group sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			for j := 0; j < 100; j++ {
+				v.noteMetadataChange("same", false)
+				v.readMetadataChanges(0, 256)
+			}
+		}()
+	}
+	group.Wait()
+	require.Equal(t, uint64(800), v.readMetadataChanges(0, 1)["latest"])
+}
+
+func TestMetadataChangesResponseBudget(t *testing.T) {
+	var v VFS
+	for i := 0; i < 256; i++ {
+		v.noteMetadataChange(strings.Repeat("\n", 4096), false)
+	}
+	page := v.readMetadataChanges(0, 256)
+	data, err := json.MarshalIndent(page, "", "\t")
+	require.NoError(t, err)
+	require.Less(t, len(data), 1024*1024)
+	require.Equal(t, true, page["hasMore"])
+	require.NotEmpty(t, page["events"])
+}
