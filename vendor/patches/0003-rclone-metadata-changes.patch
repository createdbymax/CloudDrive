+package vfs
+
+import (
+	"context"
+	"crypto/rand"
+	"fmt"
+	"sync"
+
+	"github.com/rclone/rclone/fs/rc"
+)
+
+const metadataChangeRetention = 4096
+
+type metadataChange struct {
+	Sequence  uint64 `json:"sequence"`
+	Path      string `json:"path"`
+	Recursive bool   `json:"recursive"`
+}
+
+type metadataChanges struct {
+	mu       sync.Mutex
+	session  string
+	sequence uint64
+	events   []metadataChange
+}
+
+// noteMetadataChange records an invalidation hint, never a claim of publication.
+// Network and disk work must remain outside mutation locks and callbacks.
+func (vfs *VFS) noteMetadataChange(path string, recursive bool) {
+	c := &vfs.metadataChanges
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.session == "" {
+		c.session = rand.Text()
+	}
+	c.sequence++
+	if len(path) > 4096 {
+		path, recursive = "", true
+	}
+	event := metadataChange{c.sequence, path, recursive}
+	if len(c.events) == metadataChangeRetention {
+		copy(c.events, c.events[1:])
+		c.events[len(c.events)-1] = event
+	} else {
+		c.events = append(c.events, event)
+	}
+}
+
+func (vfs *VFS) readMetadataChanges(after uint64, limit int) rc.Params {
+	c := &vfs.metadataChanges
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.session == "" {
+		c.session = rand.Text()
+	}
+	first := c.sequence + 1
+	if len(c.events) > 0 {
+		first = c.events[0].Sequence
+	}
+	events := make([]metadataChange, 0, limit)
+	gap := after > c.sequence || (first > 1 && after < first-1)
+	next := after
+	if gap {
+		next = first - 1
+	}
+	budget := 0
+	for _, event := range c.events {
+		if event.Sequence > next {
+			estimated := len(event.Path)*6 + 128
+			if len(events) > 0 && budget+estimated > 512*1024 {
+				break
+			}
+			budget += estimated
+			events = append(events, event)
+			if len(events) == limit {
+				break
+			}
+		}
+	}
+	if len(events) > 0 {
+		next = events[len(events)-1].Sequence
+	}
+	return rc.Params{"version": 1, "session": c.session, "first": first, "latest": c.sequence,
+		"events": events, "next": next, "hasMore": next < c.sequence, "gap": gap}
+}
+
+func init() {
+	rc.Add(rc.Call{Path: "vfs/metadata-changes", NoAuth: false,
+		Title: "Read bounded metadata invalidation hints.",
+		Help:  "Returns process-local ordered hints. Restart/session changes and retention gaps require reconciliation.",
+		Fn: func(ctx context.Context, in rc.Params) (rc.Params, error) {
+			vfs, err := getVFS(in)
+			if err != nil {
+				return nil, err
+			}
+			after, err := in.GetInt64("after")
+			if err != nil || after < 0 {
+				return nil, fmt.Errorf("after must be a nonnegative integer")
+			}
+			limit, err := in.GetInt64("limit")
+			if err != nil || limit < 1 || limit > 256 {
+				return nil, fmt.Errorf("limit must be between 1 and 256")
+			}
+			return vfs.readMetadataChanges(uint64(after), int(limit)), nil
+		}})
+}
