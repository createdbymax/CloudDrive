+// Modified for CloudDrive. A small volume-wide cache lets consecutive NFS READs
+// share one verified immutable chunk. Never hold its mutex during network I/O.
+package vfscache
+
+import "sync"
+
+type verifiedPage struct {
+	key  string
+	data []byte
+}
+type spillReadCache struct {
+	mu    sync.Mutex
+	pages [4]verifiedPage
+	next  int
+}
+
+func (c *spillReadCache) get(key string) []byte {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for _, page := range c.pages {
+		if page.key == key {
+			return page.data
+		}
+	}
+	return nil
+}
+func (c *spillReadCache) put(key string, data []byte) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for _, page := range c.pages {
+		if page.key == key {
+			return
+		}
+	}
+	c.pages[c.next] = verifiedPage{key, data}
+	c.next = (c.next + 1) % len(c.pages)
+}
