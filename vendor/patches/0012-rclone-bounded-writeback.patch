+func TestVerifiedSpillLargeIndex(t *testing.T) {
+	c, i, _ := setupSpillTest(t)
+	i.mu.Lock()
+	require.NoError(t, i.beginSpill())
+	i.mu.Unlock()
+	s := i.info.Spill
+	// 76,800 distinct segments represent 300 GiB of mapped content.
+	for page := int64(0); page < 76800; page++ {
+		key := fmt.Sprintf("%x", sha256.Sum256([]byte(fmt.Sprint(page))))
+		s.Keys[key] = true
+		s.logKey(key)
+		s.Pages[page] = spillRef{key, spillPage}
+		s.logPage(page)
+	}
+	require.NoError(t, i.saveSpillInfo())
+	initial := s.IndexBytes
+	delete(s.Pages, 17)
+	s.logPage(17)
+	require.NoError(t, i.saveSpillInfo())
+	require.Equal(t, int64(indexRecordSize), s.IndexBytes-initial)
+	meta, err := os.Stat(c.toOSPathMeta(i.name))
+	require.NoError(t, err)
+	require.Less(t, meta.Size(), int64(2048))
+	replay := &Item{c: c, name: i.name}
+	_, err = replay.load()
+	require.NoError(t, err)
+	require.Equal(t, 76799, len(replay.info.Spill.Pages))
+	require.Equal(t, s.Pages[76799], replay.info.Spill.Pages[76799])
+	require.False(t, replay.info.Spill.Keys["bad"])
+	fd, err := os.OpenFile(i.indexPath(), os.O_WRONLY, 0)
+	require.NoError(t, err)
+	_, err = fd.WriteAt([]byte{1, 2, 3}, s.IndexBytes)
+	require.NoError(t, err)
+	require.NoError(t, fd.Close())
+	replay = &Item{c: c, name: i.name}
+	_, err = replay.load()
+	require.NoError(t, err)
+	fd, err = os.OpenFile(i.indexPath(), os.O_WRONLY, 0)
+	require.NoError(t, err)
+	_, err = fd.WriteAt([]byte{0xf0}, s.IndexBytes-1)
+	require.NoError(t, err)
+	require.NoError(t, fd.Close())
+	replay = &Item{c: c, name: i.name}
+	_, err = replay.load()
+	require.Error(t, err)
+}
