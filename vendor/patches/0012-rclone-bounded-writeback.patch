+// Modified for CloudDrive: convert an incompletely hydrated existing file without
+// materializing its old bytes on the cache volume.
+package vfscache
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/lib/ranges"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+// An adoption is private preparation. Until the complete metadata swap, the old
+// object and every dirty local interval remain authoritative. A single conditional
+// GET supplies the original bytes while local acknowledged changes take precedence.
+func (i *Item) adoptBase(s *spillState) error {
+	p, ok := i.c.spill.(interface {
+		OpenSpillBase(context.Context, fs.Object) (io.ReadCloser, error)
+	})
+	if !ok {
+		return errors.New("provider lacks conditional base snapshot")
+	}
+	if i.info.Size > maxSpillPages*spillPage {
+		return errors.New("spill source too large")
+	}
+	in, err := p.OpenSpillBase(i.c.ctx, i.o)
+	if err != nil {
+		return err
+	}
+	defer in.Close()
+	s.AdoptingName = i.name
+	prep := filepath.Join(i.c.spillAux, s.Generation+".adopting")
+	staged := &Item{c: i.c, name: i.name, info: i.info}
+	staged.info.Spill = s
+	staged.info.Dirty = true
+	staged.info.Rs = append(ranges.Ranges(nil), i.info.Rs...)
+	if err = staged.commitSpillIndexAt(prep); err != nil {
+		return err
+	}
+	// A pre-publication failure leaves the original authoritative. Its private
+	// generation can then be cleaned independently, including after owner restart.
+	committed := false
+	defer func() {
+		if !committed {
+			if err := i.c.retireAdoption(prep); err != nil {
+				fs.Errorf(i.name, "retained private adoption for recovery: %v", err)
+			}
+		}
+	}()
+	for off := int64(0); off < i.info.Size; off += spillPage {
+		size := min(spillPage, i.info.Size-off)
+		part := ranges.Range{Pos: off, Size: size}
+		remoteBytes := max(int64(0), min(size, i.o.Size()-off))
+		if i.info.Rs.Present(part) {
+			if _, err = io.CopyN(io.Discard, in, remoteBytes); err != nil {
+				return err
+			}
+			continue
+		}
+		data := make([]byte, size)
+		if _, err = io.ReadFull(in, data[:remoteBytes]); err != nil {
+			return err
+		}
+		for _, present := range i.info.Rs.Intersection(part) {
+			if _, err = i.fd.ReadAt(data[present.Pos-off:present.End()-off], present.Pos); err != nil {
+				return err
+			}
+		}
+		digest := fmt.Sprintf("%x", sha256.Sum256(data))
+		if !s.Keys[digest] {
+			s.Keys[digest] = true
+			s.logKey(digest)
+			if err = staged.commitSpillIndexAt(prep); err != nil {
+				return err
+			}
+			if err = i.c.spill.StoreSpillChunk(i.c.ctx, s.key(digest), data); err != nil {
+				return err
+			}
+		}
+		page := off / spillPage
+		s.Pages[page] = spillRef{digest, size}
+		s.logPage(page)
+		staged.info.Rs = eraseResident(staged.info.Rs, off, off+spillPage)
+	}
+	if err = i.fd.Sync(); err != nil {
+		return err
+	}
+	if err = staged.commitSpillIndexAt(prep); err != nil {
+		return err
+	}
+	if err = staged.saveSpillInfo(); err != nil {
+		return err
+	}
+	i.info = staged.info
+	committed = true
+	if err = i.c.reclaimSealed(i); err != nil {
+		i.spillFault = err
+		return err
+	}
+	if err = os.Remove(prep); err != nil && !os.IsNotExist(err) {
+		fs.Errorf(i.name, "retained adoption checkpoint: %v", err)
+	}
+	i.accountDirtySpill()
+	return nil
+}
+func (c *Cache) retireAdoption(path string) error {
+	var info Info
+	if err := readSpillRecord(path, &info); err != nil {
+		return err
+	}
+	s := info.Spill
+	if s == nil || s.AdoptingName == "" || clean(s.AdoptingName) != s.AdoptingName || filepath.IsAbs(s.AdoptingName) || filepath.Base(path) != s.Generation+".adopting" {
+		return errors.New("invalid adoption checkpoint")
+	}
+	// Confirm any live mapping before validating an old preparation checkpoint.
+	// A completed adoption's index may have subsequently been reclaimed.
+	var live Info
+	err := readSpillRecord(c.toOSPathMeta(s.AdoptingName), &live)
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	if live.Spill != nil && live.Spill.Generation == s.Generation {
+		return os.Remove(path)
+	}
+	temp := Item{c: c, name: s.AdoptingName, info: info}
+	if err = temp.validSpill(); err != nil {
+		return err
+	}
+	if _, err = temp.stageCleanup(); err != nil {
+		return err
+	}
+	return os.Remove(path)
+}
