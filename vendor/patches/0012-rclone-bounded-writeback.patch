+// Modified for CloudDrive: append only changed mappings before committing their
+// verified prefix in the atomic item metadata. Uncommitted tails are ignored.
+package vfscache
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+type indexRecord [45]byte
+
+const indexRecordSize = 45
+
+func (s *spillState) logKey(hash string) {
+	if s.Version != 2 {
+		return
+	}
+	var rec indexRecord
+	rec[0] = 1
+	hex.Decode(rec[13:], []byte(hash))
+	s.pending = append(s.pending, rec)
+}
+func (s *spillState) logPage(page int64) {
+	if s.Version != 2 {
+		return
+	}
+	var rec indexRecord
+	rec[0] = 3
+	binary.BigEndian.PutUint64(rec[1:9], uint64(page))
+	if ref, ok := s.Pages[page]; ok {
+		rec[0] = 2
+		binary.BigEndian.PutUint32(rec[9:13], uint32(ref.Bytes))
+		hex.Decode(rec[13:], []byte(ref.Hash))
+	}
+	s.pending = append(s.pending, rec)
+}
+func chainIndex(prev [32]byte, record indexRecord) [32]byte {
+	var block [32 + indexRecordSize]byte
+	copy(block[:32], prev[:])
+	copy(block[32:], record[:])
+	return sha256.Sum256(block[:])
+}
+func (i *Item) indexPath() string {
+	return filepath.Join(i.c.spillAux, i.info.Spill.Generation+".index")
+}
+func (i *Item) commitSpillIndex() error {
+	return i.commitSpillIndexAt(i.c.toOSPathMeta(i.name))
+}
+func (i *Item) commitSpillIndexAt(meta string) error {
+	info := i.info
+	s := info.Spill
+	if s == nil || s.Version == 1 {
+		return durableJSONIn(i.c.spillAux, meta, &info)
+	}
+	snapshot := *s
+	snapshot.Pages = nil
+	snapshot.Keys = nil
+	if len(s.pending) > 0 {
+		f, err := os.OpenFile(i.indexPath(), os.O_CREATE|os.O_RDWR, 0600)
+		if err != nil {
+			return err
+		}
+		if _, err = f.Seek(s.IndexBytes, io.SeekStart); err == nil {
+			w := bufio.NewWriter(f)
+			for _, record := range s.pending {
+				if _, err = w.Write(record[:]); err != nil {
+					break
+				}
+				snapshot.IndexDigest = chainIndex(snapshot.IndexDigest, record)
+				snapshot.IndexBytes += indexRecordSize
+			}
+			if err == nil {
+				err = w.Flush()
+			}
+			if err == nil {
+				err = f.Sync()
+			}
+		}
+		if closeErr := f.Close(); err == nil {
+			err = closeErr
+		}
+		if err != nil {
+			return err
+		}
+		if s.IndexBytes == 0 {
+			d, err := os.Open(i.c.spillAux)
+			if err != nil {
+				return err
+			}
+			err = d.Sync()
+			d.Close()
+			if err != nil {
+				return err
+			}
+		}
+	}
+	info.Spill = &snapshot
+	if err := durableJSONIn(i.c.spillAux, meta, &info); err != nil {
+		return err
+	}
+	s.IndexBytes = snapshot.IndexBytes
+	s.IndexDigest = snapshot.IndexDigest
+	s.pending = nil
+	return nil
+}
+func (i *Item) readSpillIndex() error {
+	s := i.info.Spill
+	if s.IndexBytes < 0 || s.IndexBytes%indexRecordSize != 0 || s.Keys != nil || s.Pages != nil {
+		return errors.New("invalid committed spill index")
+	}
+	keys := make(map[string]bool)
+	pages := make(map[int64]spillRef)
+	var digest [32]byte
+	if s.IndexBytes > 0 {
+		f, err := os.Open(i.indexPath())
+		if err != nil {
+			return err
+		}
+		defer f.Close()
+		st, err := f.Stat()
+		if err != nil {
+			return err
+		}
+		if !st.Mode().IsRegular() || st.Size() < s.IndexBytes {
+			return errors.New("short spill index")
+		}
+		r := bufio.NewReader(f)
+		for off := int64(0); off < s.IndexBytes; off += indexRecordSize {
+			var rec indexRecord
+			if _, err := io.ReadFull(r, rec[:]); err != nil {
+				return err
+			}
+			digest = chainIndex(digest, rec)
+			page := binary.BigEndian.Uint64(rec[1:9])
+			length := int64(binary.BigEndian.Uint32(rec[9:13]))
+			if page >= maxSpillPages {
+				return errors.New("invalid spill index offset")
+			}
+			switch rec[0] {
+			case 1:
+				keys[hex.EncodeToString(rec[13:])] = true
+			case 2:
+				hash := hex.EncodeToString(rec[13:])
+				if !keys[hash] || length <= 0 || length > spillPage {
+					return errors.New("unowned spill mapping")
+				}
+				pages[int64(page)] = spillRef{hash, length}
+			case 3:
+				delete(pages, int64(page))
+			default:
+				return errors.New("unknown spill index operation")
+			}
+			if len(keys) > maxSpillPages {
+				return errors.New("oversized spill index")
+			}
+		}
+	}
+	if digest != s.IndexDigest {
+		return errors.New("spill index checksum mismatch")
+	}
+	s.Keys = keys
+	s.Pages = pages
+	return nil
+}
