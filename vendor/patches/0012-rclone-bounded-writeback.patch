+// Modified for CloudDrive: local ownership records and restart-safe private-object cleanup.
+package vfscache
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config"
+	"golang.org/x/sync/errgroup"
+)
+
+const maxSpillRecord = 192 << 20
+
+func readSpillRecord(path string, v any) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	stat, err := f.Stat()
+	if err != nil {
+		return err
+	}
+	if !stat.Mode().IsRegular() || stat.Size() > maxSpillRecord {
+		return errors.New("invalid writeback metadata record")
+	}
+	d := json.NewDecoder(io.LimitReader(f, maxSpillRecord+1))
+	if err = d.Decode(v); err != nil {
+		return err
+	}
+	if d.Decode(new(any)) != io.EOF {
+		return errors.New("trailing writeback metadata")
+	}
+	return nil
+}
+func (c *Cache) checkSpillBinding() error {
+	c.spillAux = filepath.Join(config.GetCacheDir(), "clouddrive-writeback-v1", fmt.Sprintf("%x", sha256.Sum256([]byte(c.metaRoot))))
+	marker := filepath.Join(c.spillAux, "binding.json")
+	var recorded string
+	e := readSpillRecord(marker, &recorded)
+	if e == nil {
+		if !spillPrefixRE.MatchString(recorded) || recorded != c.opt.SpillPrefix {
+			return errors.New("cache belongs to another writeback namespace")
+		}
+		return nil
+	}
+	if !os.IsNotExist(e) {
+		return e
+	}
+	return nil
+}
+
+// Pin the local cache only after the provider has verified its ownership marker.
+func (c *Cache) recordSpillBinding() error {
+	if err := os.MkdirAll(c.spillAux, 0700); err != nil {
+		return err
+	}
+	marker := filepath.Join(c.spillAux, "binding.json")
+	var existing string
+	if e := readSpillRecord(marker, &existing); e == nil {
+		if existing != c.opt.SpillPrefix {
+			return errors.New("cache binding changed during startup")
+		}
+		return nil
+	} else if !os.IsNotExist(e) {
+		return e
+	}
+	return durableJSONIn(c.spillAux, marker, c.opt.SpillPrefix)
+
+}
+func (c *Cache) validateSpillRecovery() error {
+	// Validate every metadata record before legacy reload can discard an orphan.
+	return c.walk(c.metaRoot, func(path string, fi os.FileInfo, name string) error {
+		if fi.IsDir() {
+			return nil
+		}
+		var info Info
+		if err := readSpillRecord(path, &info); err != nil {
+			return fmt.Errorf("retained invalid cache metadata for %q: %w", name, err)
+		}
+		if info.Spill == nil {
+			return nil
+		}
+		item := Item{c: c, name: name, info: info}
+		if err := item.validSpill(); err != nil {
+			return err
+		}
+		local, err := os.Lstat(c.toOSPath(name))
+		if err != nil {
+			return fmt.Errorf("retained incomplete dirty cache: %w", err)
+		}
+		if !local.Mode().IsRegular() || local.Size() < info.Size {
+			return errors.New("dirty cache backing size mismatch")
+		}
+		if err = c.reclaimSealed(&item); err != nil {
+			return err
+		}
+		return nil
+	})
+}
+
+// A crash after saving the remote mapping and before releasing local blocks
+// leaves a redundant copy. Reclaim it before accepting more writes.
+func (c *Cache) reclaimSealed(i *Item) error {
+	if len(i.info.Spill.Pages) == 0 {
+		return nil
+	}
+	fd, err := os.OpenFile(c.toOSPath(i.name), os.O_RDWR, 0)
+	if err != nil {
+		return err
+	}
+	defer fd.Close()
+	for page := range i.info.Spill.Pages {
+		if err = punchSpill(fd, page*spillPage, spillPage); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+type cleanupTicket struct {
+	Name, Prefix, Generation string
+	Keys                     map[string]bool
+}
+
+func (i *Item) stageCleanup() (string, error) {
+	s := i.info.Spill
+	t := cleanupTicket{i.name, s.Prefix, s.Generation, s.Keys}
+	path := filepath.Join(i.c.spillAux, s.Generation+".cleanup")
+	return path, durableJSONIn(i.c.spillAux, path, t)
+}
+func (c *Cache) finishCleanup(ctx context.Context, path string) error {
+	var t cleanupTicket
+	if err := readSpillRecord(path, &t); err != nil {
+		return err
+	}
+	u, err := uuid.Parse(t.Generation)
+	if err != nil || u.Version() != 4 || u.String() != t.Generation || filepath.Base(path) != t.Generation+".cleanup" || t.Prefix != c.opt.SpillPrefix || len(t.Keys) > maxSpillPages || t.Name == "" || clean(t.Name) != t.Name || filepath.IsAbs(t.Name) || t.Name == ".." || strings.HasPrefix(t.Name, "../") {
+		return errors.New("invalid writeback cleanup ticket")
+	}
+	var info Info
+	e := readSpillRecord(c.toOSPathMeta(t.Name), &info)
+	if e != nil && !os.IsNotExist(e) {
+		return e
+	}
+	if e == nil && info.Spill != nil && info.Spill.Generation == t.Generation {
+		return nil
+	}
+	group, work := errgroup.WithContext(ctx)
+	group.SetLimit(4)
+	for h := range t.Keys {
+		if work.Err() != nil {
+			break
+		}
+		key := t.Prefix + "/" + t.Generation + "/" + h
+		group.Go(func() error { return c.spill.DeleteSpillChunk(work, key) })
+	}
+	if err := group.Wait(); err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := os.Remove(filepath.Join(c.spillAux, t.Generation+".index")); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return os.Remove(path)
+}
+func (c *Cache) retrySpillCleanup(ctx context.Context) {
+	matches, err := filepath.Glob(filepath.Join(c.spillAux, "*.cleanup"))
+	if err != nil {
+		return
+	}
+	for _, path := range matches {
+		if ctx.Err() != nil {
+			return
+		}
+		if err := c.finishCleanup(ctx, path); err != nil && !os.IsNotExist(err) {
+			fs.Errorf(nil, "retained writeback cleanup ticket: %v", err)
+		}
+	}
+}
