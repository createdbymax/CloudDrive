+func TestVerifiedSpillTruncatedExistingAndVolumeBudget(t *testing.T) {
+	c, i, p := setupSpillTest(t)
+	// First publish under the window, then truncate the existing object and write a
+	// replacement far larger than the window. The old suffix cannot reappear.
+	_, e := i.WriteAt([]byte("old bytes"), 0)
+	require.NoError(t, e)
+	require.NoError(t, i.Close(nil))
+	obj, e := c.fremote.NewObject(context.Background(), "ordinary")
+	require.NoError(t, e)
+	require.NoError(t, i.Open(obj))
+	require.NoError(t, i.Truncate(0))
+	page := bytes.Repeat([]byte{0xab}, int(spillPage))
+	for j := int64(0); j < 4; j++ {
+		page[0] = byte(j)
+		_, e = i.WriteAt(page, j*spillPage)
+		require.NoError(t, e)
+	}
+	require.NotNil(t, i.info.Spill)
+	second, _ := c.get("second")
+	require.NoError(t, second.Open(nil))
+	// Parallel sealing can free several pages at once. Write enough to force
+	// the second writer into staging even if the first has freed its whole window.
+	block := bytes.Repeat([]byte{0xef}, 256<<10)
+	for j := 0; j < 36; j++ {
+		block[0] = byte(j)
+		_, e = second.WriteAt(block, int64(j*len(block)))
+		require.NoError(t, e)
+	}
+	require.NotNil(t, second.info.Spill)
+	total := uint64(0)
+	for _, name := range []string{"ordinary", "second"} {
+		used, err := c.AllocatedBytes(name)
+		require.NoError(t, err)
+		total += used
+	}
+	require.LessOrEqual(t, total, uint64(c.opt.SpillWindow)+8192)
+	require.NoError(t, second.Close(nil))
+	require.NoError(t, i.Close(nil))
+	require.Empty(t, p.chunks)
+}
