+package vfscache
+
+import (
+	"golang.org/x/sys/unix"
+	"os"
+	"unsafe"
+)
+
+func punchSpill(fd *os.File, off, length int64) error {
+	req := struct {
+		Flags          uint32
+		Reserved       uint32
+		Offset, Length int64
+	}{Offset: off, Length: length}
+	_, _, e := unix.Syscall(unix.SYS_FCNTL, fd.Fd(), unix.F_PUNCHHOLE, uintptr(unsafe.Pointer(&req)))
+	if e != 0 {
+		return e
+	}
+	return nil
+}
