+// Modified for CloudDrive: stream a single conditional view of an existing R2 object.
+package s3
+
+import (
+	"context"
+	"errors"
+	"github.com/rclone/rclone/fs"
+	"io"
+)
+
+func (f *Fs) OpenSpillBase(ctx context.Context, source fs.Object) (io.ReadCloser, error) {
+	src, ok := source.(*Object)
+	if !ok || src.fs != f || f.opt.DownloadURL != "" {
+		return nil, errors.New("unsupported spill source")
+	}
+	head, err := src.headObject(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if head.ETag == nil || *head.ETag == "" || head.ContentLength == nil || *head.ContentLength != src.Size() {
+		return nil, errors.New("spill source changed")
+	}
+	return src.Open(ctx, &fs.HTTPOption{Key: "If-Match", Value: *head.ETag})
+}
