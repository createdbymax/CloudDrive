+func TestVerifiedSpillColdEditAndAlreadyPublishedAppend(t *testing.T) {
+	ctx := context.Background()
+	c, unused, p := setupSpillTest(t)
+	require.NoError(t, unused.Close(nil))
+	data := make([]byte, 80<<20)
+	for pos := range data {
+		data[pos] = byte((int64(pos)/spillPage + int64(pos%251)) % 256)
+	}
+	obj, e := c.fremote.Put(ctx, bytes.NewReader(data), object.NewStaticObjectInfo("cold", time.Now(), int64(len(data)), true, nil, c.fremote))
+	require.NoError(t, e)
+	i, _ := c.get("cold")
+	require.NoError(t, i.Open(obj))
+	require.Equal(t, int64(len(data)), i.info.Size)
+	p.failBase = true
+	_, e = i.WriteAt([]byte("edit"), int64(8<<20))
+	require.Error(t, e)
+	require.Nil(t, i.info.Spill)
+	require.False(t, i.IsDirty())
+	p.failBase = false
+	_, e = i.WriteAt([]byte("edit"), int64(8<<20))
+	require.NoError(t, e)
+	copy(data[8<<20:], "edit")
+	allocation, e := c.AllocatedBytes("cold")
+	require.NoError(t, e)
+	require.LessOrEqual(t, allocation, uint64(c.opt.SpillWindow))
+	require.NoError(t, i.Close(nil))
+	require.Empty(t, p.chunks)
+	// NFS can pause beyond the writeback delay and resume at a newer offset.
+	// Re-open the published sparse file, leaving a zero-filled gap before the tail.
+	obj, e = c.fremote.NewObject(ctx, "cold")
+	require.NoError(t, e)
+	require.NoError(t, i.Open(obj))
+	data = append(data, make([]byte, 777)...)
+	at := int64(len(data))
+	_, e = i.WriteAt([]byte("tail"), at)
+	require.NoError(t, e)
+	data = append(data, []byte("tail")...)
+	allocation, e = c.AllocatedBytes("cold")
+	require.NoError(t, e)
+	require.LessOrEqual(t, allocation, uint64(c.opt.SpillWindow))
+	require.NoError(t, i.Close(nil))
+	obj, e = c.fremote.NewObject(ctx, "cold")
+	require.NoError(t, e)
+	rd, e := obj.Open(ctx)
+	require.NoError(t, e)
+	got, e := io.ReadAll(rd)
+	require.NoError(t, e)
+	require.NoError(t, rd.Close())
+	require.True(t, bytes.Equal(data, got))
+}
