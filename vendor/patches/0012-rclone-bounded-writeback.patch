+)
+
+type testSpill struct {
+	mu                            sync.Mutex
+	chunks                        map[string][]byte
+	failPut, failDelete, failBase bool
+}
+
+func (b *testSpill) InitSpillNamespace(context.Context, string) error { return nil }
+func (b *testSpill) StoreSpillChunk(_ context.Context, key string, p []byte) error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.failPut {
+		return errors.New("injected precommit failure")
+	}
+	if !strings.HasSuffix(key, fmt.Sprintf("%x", sha256.Sum256(p))) {
+		return errors.New("wrong digest")
+	}
+	b.chunks[key] = bytes.Clone(p)
+	return nil
+}
+func (b *testSpill) ReadSpillChunk(_ context.Context, key string) ([]byte, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if p, ok := b.chunks[key]; ok {
+		return bytes.Clone(p), nil
+	}
+	return nil, os.ErrNotExist
+}
+func (b *testSpill) DeleteSpillChunk(_ context.Context, key string) error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.failDelete {
+		return errors.New("retained")
+	}
+	delete(b.chunks, key)
+	return nil
+}
+func setupSpillTest(t *testing.T) (*Cache, *Item, *testSpill) {
+	_, c := newItemTestCache(t)
+	provider := &testSpill{chunks: map[string][]byte{}}
+	c.spill = provider
+	c.spillAux = t.TempDir()
+	c.opt.SpillPrefix = ".clouddrive-spill-" + strings.Repeat("a", 64)
+	c.opt.SpillWindow = fs.SizeSuffix(spillPage * 2)
+	c.spillResident = map[*Item]int64{}
+	i, _ := c.get("ordinary")
+	require.NoError(t, i.Open(nil))
+	return c, i, provider
+}
+func TestVerifiedSpillOverlayRecovery(t *testing.T) {
+	c, i, p := setupSpillTest(t)
+	data := make([]byte, spillPage*6)
+	for k := range data {
+		data[k] = byte((int64(k)/spillPage + 1) * int64(1+k%241))
+	}
+	for pos := int64(0); pos < int64(len(data)); pos += 1 << 20 {
+		n, e := i.WriteAt(data[pos:pos+(1<<20)], pos)
+		require.NoError(t, e)
+		require.Equal(t, 1<<20, n)
+	}
+	require.NotEmpty(t, p.chunks)
+	alloc, e := c.AllocatedBytes("ordinary")
+	require.NoError(t, e)
+	require.LessOrEqual(t, alloc, uint64(spillPage*2+4096))
+	bytesAt := func(pos, n int64) {
+		t.Helper()
+		got := make([]byte, n)
+		count, e := i.ReadAt(got, pos)
+		require.NoError(t, e)
+		require.Equal(t, int(n), count)
+		require.True(t, bytes.Equal(got, data[pos:pos+n]))
+	}
+	bytesAt(spillPage-300, 801)
+	replace := bytes.Repeat([]byte{0xac}, 900)
+	pos := spillPage - 450
+	n, e := i.WriteAt(replace, pos)
+	require.NoError(t, e)
+	require.Equal(t, len(replace), n)
+	copy(data[pos:], replace)
+	bytesAt(pos, 900)
+	cut := spillPage + 1201
+	require.NoError(t, i.Truncate(cut))
+	data = data[:cut]
+	require.NoError(t, i.Truncate(cut+8192))
+	data = append(data, make([]byte, 8192)...)
+	bytesAt(cut-40, 5000)
+	require.ErrorIs(t, i.rename("ordinary", "moved", nil), syscall.EBUSY)
+	require.NoError(t, i.Sync())
+	// A fresh reader sees exactly the last durable mapping. Do not run the dying
+	// instance's upload/cleanup code: the recovery instance owns it from here.
+	require.NoError(t, i.fd.Close())
+	i.fd = nil
+	replay := newItem(c, "ordinary")
+	c.mu.Lock()
+	c.item["ordinary"] = replay
+	c.mu.Unlock()
+	i = replay
+	require.NoError(t, i.Open(nil))
+	bytesAt(0, int64(len(data)))
+	p.failDelete = true
+	require.NoError(t, i.Close(nil))
+	require.NotEmpty(t, p.chunks)
+	obj, e := c.fremote.NewObject(context.Background(), "ordinary")
+	require.NoError(t, e)
+	r, e := obj.Open(context.Background())
+	require.NoError(t, e)
+	got, e := io.ReadAll(r)
+	require.NoError(t, e)
+	require.NoError(t, r.Close())
+	require.True(t, bytes.Equal(got, data))
+	matches, e := filepath.Glob(filepath.Join(c.spillAux, "*.cleanup"))
+	require.NoError(t, e)
+	require.Len(t, matches, 1)
+	p.failDelete = false
+	c.retrySpillCleanup(context.Background())
+	require.Empty(t, p.chunks)
+}
+func TestVerifiedSpillProviderFailureRetainsLocalBytes(t *testing.T) {
+	_, i, p := setupSpillTest(t)
