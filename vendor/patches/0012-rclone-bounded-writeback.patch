+// Modified for CloudDrive. Reclaim consecutive complete pages together to overlap
+// WAN requests. The item lock protects the selected bytes until their mappings commit.
+package vfscache
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"sync"
+
+	"github.com/rclone/rclone/lib/ranges"
+)
+
+const spillBatchSize = 4
+
+// Each worker owns one mounted volume. Across all active items, at most four
+// batch payloads are admitted. Contention leaves the existing single-page path available.
+var spillBatchSlots = make(chan struct{}, spillBatchSize)
+
+func (i *Item) sealBatch(current int64) (bool, error) {
+	var pages []int64
+	for _, r := range i.info.Rs {
+		for p := (r.Pos + spillPage - 1) / spillPage; (p+1)*spillPage <= r.End() && len(pages) < spillBatchSize; p++ {
+			if p != current {
+				pages = append(pages, p)
+			}
+		}
+		if len(pages) == spillBatchSize {
+			break
+		}
+	}
+	if len(pages) < 2 {
+		return false, nil
+	}
+	reserved := 0
+reserve:
+	for reserved < len(pages) {
+		select {
+		case spillBatchSlots <- struct{}{}:
+			reserved++
+		default:
+			break reserve
+		}
+	}
+	defer func() {
+		for j := 0; j < reserved; j++ {
+			<-spillBatchSlots
+		}
+	}()
+	if reserved < 2 {
+		return false, nil
+	}
+	pages = pages[:reserved]
+	s := i.info.Spill
+	type chunk struct {
+		data []byte
+		hash string
+		err  error
+	}
+	chunks := make([]chunk, len(pages))
+	for j, page := range pages {
+		b := make([]byte, spillPage)
+		if _, err := i.fd.ReadAt(b, page*spillPage); err != nil {
+			return false, err
+		}
+		h := fmt.Sprintf("%x", sha256.Sum256(b))
+		if !s.Keys[h] {
+			if len(s.Keys) >= maxSpillPages {
+				return false, fmt.Errorf("spill reference limit reached")
+			}
+			s.Keys[h] = true
+			s.logKey(h)
+		}
+		chunks[j] = chunk{data: b, hash: h}
+	}
+	// Never dispatch a PUT until every attempted key has a durable owner.
+	if err := i.saveSpillInfo(); err != nil {
+		return false, err
+	}
+	var wg sync.WaitGroup
+	ctx, cancel := context.WithCancel(i.c.ctx)
+	defer cancel()
+	for j := range chunks {
+		wg.Add(1)
+		go func(j int) {
+			defer wg.Done()
+			c := &chunks[j]
+			c.err = i.c.spill.StoreSpillChunk(ctx, s.key(c.hash), c.data)
+			if c.err != nil {
+				cancel()
+			}
+		}(j)
+	}
+	wg.Wait()
+	for _, c := range chunks {
+		if c.err != nil {
+			return false, c.err
+		}
+	}
+	old := append(ranges.Ranges(nil), i.info.Rs...)
+	for j, page := range pages {
+		off := page * spillPage
+		i.info.Rs = eraseResident(i.info.Rs, off, off+spillPage)
+		s.Pages[page] = spillRef{chunks[j].hash, spillPage}
+		s.logPage(page)
+	}
+	if err := i.saveSpillInfo(); err != nil {
+		i.info.Rs = old
+		for _, page := range pages {
+			delete(s.Pages, page)
+			s.logPage(page)
+		}
+		return false, err
+	}
+	for _, page := range pages {
+		if err := punchSpill(i.fd, page*spillPage, spillPage); err != nil {
+			i.spillFault = err
+			return false, err
+		}
+	}
+	i.accountDirtySpill()
+	return true, nil
+}
