+func TestVerifiedSpillCleanerDuringPublication(t *testing.T) {
+	_, i, _ := setupSpillTest(t)
+	_, err := i.WriteAt(make([]byte, spillPage*3), 0)
+	require.NoError(t, err)
+	callback := make(chan struct{})
+	allow := make(chan struct{})
+	ended := make(chan error, 1)
+	go func() { ended <- i.Close(func(fs.Object) { close(callback); <-allow }) }()
+	select {
+	case <-callback:
+	case <-time.After(5 * time.Second):
+		t.Fatal("publisher failed to enter callback")
+	}
+	removed, _ := i.RemoveNotInUse(0, false)
+	require.False(t, removed)
+	state, _, err := i.Reset()
+	require.NoError(t, err)
+	require.Equal(t, SkippedPendingAccess, state)
+	close(allow)
+	select {
+	case e := <-ended:
+		require.NoError(t, e)
+	case <-time.After(5 * time.Second):
+		t.Fatal("cache cleanup deadlocked with publication callback")
+	}
+}
