@@ -0,0 +1,640 @@
+// Modified for CloudDrive: verified sparse-cache writeback for complete local generations.
+package vfscache
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"syscall"
+
+	"github.com/google/uuid"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/object"
+	"github.com/rclone/rclone/lib/diskusage"
+	"github.com/rclone/rclone/lib/ranges"
+)
+
+var ErrSpillCache = errors.New("writeback cache cannot be mounted safely")
+
+const spillPage int64 = 4 << 20
+const maxSpillPages = 1 << 20
+
+var spillPrefixRE = regexp.MustCompile(`^[.]clouddrive-spill-[0-9a-f]{64}$`)
+
+type spillProvider interface {
+	InitSpillNamespace(context.Context, string) error
+	StoreSpillChunk(context.Context, string, []byte) error
+	ReadSpillChunk(context.Context, string) ([]byte, error)
+	DeleteSpillChunk(context.Context, string) error
+}
+type spillRef struct {
+	Hash  string
+	Bytes int64
+}
+type spillState struct {
+	AdoptingName       string `json:",omitempty"`
+	Version            int
+	Prefix, Generation string
+	Pages              map[int64]spillRef `json:",omitempty"`
+	// Every attempted immutable key remains attributable to this unique generation.
+	Keys        map[string]bool `json:",omitempty"`
+	IndexBytes  int64
+	IndexDigest [32]byte
+	pending     []indexRecord
+	validated   bool
+}
+
+func (c *Cache) initSpill(ctx context.Context) error {
+	if c.opt.SpillPrefix == "" {
+		return nil
+	}
+	p, ok := c.fremote.(spillProvider)
+	if runtime.GOOS != "darwin" || !ok || !spillPrefixRE.MatchString(c.opt.SpillPrefix) || int64(c.opt.SpillWindow) < spillPage || int64(c.opt.SpillWindow) > 1<<32 {
+		return errors.New("invalid bounded writeback configuration")
+	}
+	if err := p.InitSpillNamespace(ctx, c.opt.SpillPrefix); err != nil {
+		return err
+	}
+	c.spill = p
+	c.spillResident = make(map[*Item]int64)
+	return nil
+}
+
+// Replace the metadata atomically. A range cannot be punched until the new
+// mapping and its directory entry have both reached stable storage.
+func durableJSONIn(tmpDir, path string, v any) error {
+	dir := filepath.Dir(path)
+	f, err := os.CreateTemp(tmpDir, ".cd-save-*")
+	if err != nil {
+		return err
+	}
+	tmp := f.Name()
+	defer os.Remove(tmp)
+	err = json.NewEncoder(f).Encode(v)
+	if err == nil {
+		err = f.Sync()
+	}
+	if closeErr := f.Close(); err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = os.Rename(tmp, path)
+	}
+	if err == nil {
+		d, e := os.Open(dir)
+		if e != nil {
+			return e
+		}
+		err = d.Sync()
+		_ = d.Close()
+	}
+	return err
+}
+func (i *Item) saveSpillInfo() error {
+	return i.commitSpillIndex()
+}
+func (i *Item) waitSpill() {
+	for i.spillPublishing != nil {
+		done := i.spillPublishing
+		i.mu.Unlock()
+		<-done
+		i.mu.Lock()
+	}
+}
+func (i *Item) validSpill() error {
+	s := i.info.Spill
+	if s == nil {
+		return nil
+	}
+	u, e := uuid.Parse(s.Generation)
+	if i.c.spill == nil || (s.Version != 1 && s.Version != 2) || s.Prefix != i.c.opt.SpillPrefix || e != nil || u.Version() != 4 || u.String() != s.Generation || len(s.Pages) > maxSpillPages || len(s.Keys) > maxSpillPages {
+		return errors.New("invalid or unavailable dirty spill generation")
+	}
+	if s.validated {
+		return nil
+	}
+	if s.Version == 2 {
+		if err := i.readSpillIndex(); err != nil {
+			return err
+		}
+	}
+	if s.Pages == nil || s.Keys == nil {
+		return errors.New("missing spill index")
+	}
+	for k := range s.Keys {
+		if len(k) != 64 {
+			return errors.New("invalid spill hash")
+		}
+		if _, err := hex.DecodeString(k); err != nil {
+			return err
+		}
+	}
+	for page, r := range s.Pages {
+		if page < 0 || page >= maxSpillPages || r.Bytes <= 0 || r.Bytes > spillPage || !s.Keys[r.Hash] {
+			return errors.New("invalid spill reference")
+		}
+	}
+	s.validated = true
+	return nil
+}
+func (i *Item) accountSpill(size int64) {
+	c := i.c
+	if c.spill == nil {
+		return
+	}
+	c.spillMu.Lock()
+	defer c.spillMu.Unlock()
+	c.spillTotal += size - c.spillResident[i]
+	if size == 0 {
+		delete(c.spillResident, i)
+	} else {
+		c.spillResident[i] = size
+	}
+}
+
+// APFS can reserve blocks outside the logical dirty extents. Charge those
+// blocks until publication or until a later punch actually releases them.
+func (i *Item) accountDirtySpill() {
+	used := i.info.Rs.Size()
+	if physical, err := i.c.AllocatedBytes(i.name); err == nil {
+		used = max(used, int64(physical))
+	}
+	i.accountSpill(used)
+}
+
+// Charge in-flight writes before releasing the admission lock. Two unrelated
+// items cannot both consume the same final bytes of the volume's dirty window.
+func (i *Item) reserveSpill(add int64) (target int64, release func()) {
+	c := i.c
+	c.spillMu.Lock()
+	own := c.spillResident[i]
+	target = max(int64(0), int64(c.opt.SpillWindow)-(c.spillTotal-own)-c.spillReserved)
+	du, err := diskusage.New(c.root)
+	if err != nil {
+		target = 0
+	} else {
+		reserve := int64(min(uint64(256<<20), max(uint64(2*spillPage), du.Total/10)))
+		target = min(target, max(int64(0), int64(du.Available)-reserve-c.spillReserved)+own)
+	}
+	claim := min(max(int64(0), target-own), max(int64(0), add))
+	c.spillReserved += claim
+	c.spillMu.Unlock()
+	return target, func() { c.spillMu.Lock(); c.spillReserved -= claim; c.spillMu.Unlock() }
+}
+func (i *Item) canBeginSpill(off, n, target int64) bool {
+	if i.c.spill == nil || off < 0 || n <= 0 {
+		return false
+	}
+	return max(i.info.Size, i.info.Rs.Size()+n, off+n) > target
+}
+func (i *Item) beginSpill() error {
+	if i.info.Spill != nil {
+		return i.validSpill()
+	}
+	u, err := uuid.NewRandom()
+	if err != nil {
+		return err
+	}
+	i._dirty()
+	state := &spillState{Version: 2, validated: true, Prefix: i.c.opt.SpillPrefix, Generation: u.String(), Pages: map[int64]spillRef{}, Keys: map[string]bool{}}
+	if i.o != nil && !i.info.Rs.Present(ranges.Range{Size: i.info.Size}) {
+		return i.adoptBase(state)
+	}
+	i.info.Spill = state
+	if err = i.fd.Sync(); err == nil {
+		err = i.saveSpillInfo()
+	}
+	return err
+}
+func (s *spillState) key(hash string) string { return s.Prefix + "/" + s.Generation + "/" + hash }
+func (c *Cache) loadPage(ctx context.Context, s *spillState, ref spillRef) ([]byte, error) {
+	if ref.Bytes <= 0 || ref.Bytes > spillPage {
+		return nil, errors.New("invalid writeback length")
+	}
+	key := s.key(ref.Hash)
+	data := c.spillReads.get(key)
+	if data == nil {
+		var err error
+		data, err = c.spill.ReadSpillChunk(ctx, key)
+		if err != nil {
+			return nil, err
+		}
+		if int64(len(data)) > spillPage || fmt.Sprintf("%x", sha256.Sum256(data)) != ref.Hash {
+			return nil, errors.New("remote spill range failed verification")
+		}
+		c.spillReads.put(key, data)
+	}
+	if int64(len(data)) < ref.Bytes {
+		return nil, errors.New("short remote spill range")
+	}
+	return data[:ref.Bytes], nil
+}
+func eraseResident(rs ranges.Ranges, lo, hi int64) ranges.Ranges {
+	left := rs.Intersection(ranges.Range{Size: lo})
+	return append(left, rs.Intersection(ranges.Range{Pos: hi, Size: 1<<61 - hi})...)
+}
+func (i *Item) sealPage(page int64) error {
+	off := page * spillPage
+	length := min(spillPage, i.info.Size-off)
+	if length <= 0 {
+		return errors.New("invalid local spill extent")
+	}
+	data := make([]byte, length)
+	if _, err := i.fd.ReadAt(data, off); err != nil {
+		return err
+	}
+	return i.persistPage(page, data)
+}
+
+func (i *Item) persistPage(page int64, data []byte) error {
+	off := page * spillPage
+	length := int64(len(data))
+	hash := fmt.Sprintf("%x", sha256.Sum256(data))
+	s := i.info.Spill
+	if _, ok := s.Keys[hash]; !ok {
+		if len(s.Keys) >= maxSpillPages {
+			return errors.New("spill reference limit reached")
+		}
+		s.Keys[hash] = true
+		s.logKey(hash)
+	}
+	if len(s.pending) > 0 || s.Version == 1 {
+		if err := i.saveSpillInfo(); err != nil {
+			return err
+		}
+	}
+	if err := i.c.spill.StoreSpillChunk(i.c.ctx, s.key(hash), data); err != nil {
+		return err
+	}
+	previous, hadPrevious := s.Pages[page]
+	old := i.info.Rs
+	i.info.Rs = eraseResident(old, off, off+spillPage)
+	s.Pages[page] = spillRef{hash, length}
+	s.logPage(page)
+	if err := i.saveSpillInfo(); err != nil {
+		i.info.Rs = old
+		if hadPrevious {
+			s.Pages[page] = previous
+		} else {
+			delete(s.Pages, page)
+		}
+		s.logPage(page)
+		return err
+	}
+	if err := punchSpill(i.fd, off, spillPage); err != nil {
+		i.spillFault = err
+		return err
+	}
+	i.accountDirtySpill()
+	return nil
+}
+
+// Restore the old page locally before admitting an overwrite to it. A failed
+// or interrupted restoration leaves the verified immutable mapping authoritative.
+func (i *Item) restorePage(page int64) error {
+	s := i.info.Spill
+	r, ok := s.Pages[page]
+	if !ok {
+		return nil
+	}
+	data, err := i.c.loadPage(i.c.ctx, s, r)
+	if err != nil {
+		return err
+	}
+	at := page * spillPage
+	n, err := i.fd.WriteAt(data, at)
+	if err != nil {
+		return err
+	}
+	if n != len(data) {
+		return io.ErrShortWrite
+	}
+	if err = i.fd.Sync(); err != nil {
+		return err
+	}
+	delete(s.Pages, page)
+	s.logPage(page)
+	i.info.Rs.Insert(ranges.Range{Pos: at, Size: int64(n)})
+	if err = i.saveSpillInfo(); err != nil {
+		return err
+	}
+	return nil
+}
+func (i *Item) writeSpill(b []byte, off, target int64) (n int, err error) {
+	if i.fd == nil || off < 0 || off > maxSpillPages*spillPage-int64(len(b)) {
+		return 0, syscall.EFBIG
+	}
+	i._dirty()
+	if err = i.beginSpill(); err != nil {
+		return 0, err
+	}
+	for len(b) > 0 {
+		page := off / spillPage
+		take := min(int64(len(b)), spillPage-off%spillPage)
+		// Prefer retaining the page that Finder is still filling.
+
+		for i.info.Rs.Size()+take > target && len(i.info.Rs) > 0 {
+			if batched, e := i.sealBatch(page); e != nil {
+				return n, e
+			} else if batched {
+				continue
+			}
+			first := i.info.Rs[0].Pos / spillPage
+			if first == page {
+				last := i.info.Rs[len(i.info.Rs)-1]
+				first = (last.End() - 1) / spillPage
+				if first == page {
+					break
+				}
+			}
+			if err = i.sealPage(first); err != nil {
+				return n, err
+			}
+		}
+		if target < spillPage || (i.info.Spill.Pages[page].Bytes+i.info.Rs.Size() > target) {
+			// Other writers or low free space may have consumed the whole local
+			// budget. Compose this page in memory and commit its remote reference
+			// without allocating another local block.
+			at := page * spillPage
+			old := max(int64(0), min(spillPage, i.info.Size-at))
+			data := make([]byte, max(old, off-at+take))
+			if old > 0 {
+				if _, err = i.readSpillAt(i.c.ctx, i.fd, data[:old], at); err != nil {
+					return n, err
+				}
+			}
+			copy(data[off-at:], b[:take])
+			if end := off + take; end > i.info.Size {
+				if err = i.fd.Truncate(end); err != nil {
+					return n, err
+				}
+				i.info.Size = end
+			}
+			if err = i.persistPage(page, data); err != nil {
+				return n, err
+			}
+			n += int(take)
+			off += take
+			b = b[take:]
+			continue
+		}
+		if err = i.restorePage(page); err != nil {
+			return n, err
+		}
+		// Extend sparsely first. APFS can otherwise speculatively allocate a
+		// large tail when a tiny write extends a large sparse inode.
+		if end := off + take; end > i.info.Size {
+			if err = i.fd.Truncate(end); err != nil {
+				return n, err
+			}
+		}
+		count, e := i.fd.WriteAt(b[:take], off)
+		if e != nil {
+			return n, e
+		}
+		if int64(count) != take {
+			return n, io.ErrShortWrite
+		}
+		i.info.Rs.Insert(ranges.Range{Pos: off, Size: take})
+		i.info.Size = max(i.info.Size, off+take)
+		off += take
+		b = b[take:]
+		n += count
+	}
+	// APFS may preallocate extra physical blocks for sparse extensions. Use
+	// physical usage to trim any reservation that exceeds the dirty budget.
+	if err = i.fd.Sync(); err != nil {
+		i.spillFault = err
+		return 0, err
+	}
+	for len(i.info.Rs) > 0 {
+		used, e := i.c.AllocatedBytes(i.name)
+		if e != nil {
+			return n, e
+		}
+		if used <= uint64(target) {
+			break
+		}
+		if e = i.sealPage(i.info.Rs[0].Pos / spillPage); e != nil {
+			return n, e
+		}
+	}
+	i.accountDirtySpill()
+	// Writes into resident pages survive abrupt owner termination. The metadata
+	// is ordered after data so a receipt never promises an unflushed local range.
+	err = i.saveSpillInfo()
+	if err != nil {
+		i.spillFault = err
+		return 0, err
+	}
+	return n, nil
+}
+func (i *Item) truncateSpill(size int64) error {
+	if size < 0 || size > maxSpillPages*spillPage {
+		return syscall.EFBIG
+	}
+	if i.fd == nil {
+		return os.ErrClosed
+	}
+	i._dirty()
+	if err := i.fd.Truncate(size); err != nil {
+		return err
+	}
+	s := i.info.Spill
+	for p, r := range s.Pages {
+		valid := size - p*spillPage
+		if valid <= 0 {
+			delete(s.Pages, p)
+			s.logPage(p)
+		} else if valid < r.Bytes {
+			r.Bytes = valid
+			s.Pages[p] = r
+			s.logPage(p)
+		}
+	}
+	i.info.Size = size
+	i.info.Rs = i.info.Rs.Intersection(ranges.Range{Size: size})
+	if err := i.fd.Sync(); err != nil {
+		i.spillFault = err
+		return err
+	}
+	err := i.saveSpillInfo()
+	if err != nil {
+		i.spillFault = err
+	}
+	i.accountDirtySpill()
+	return err
+}
+func (i *Item) readSpillAt(ctx context.Context, fd *os.File, b []byte, off int64) (n int, err error) {
+	if err = i.validSpill(); err != nil {
+		return 0, err
+	}
+	if off < 0 {
+		return 0, syscall.EINVAL
+	}
+	if len(b) == 0 {
+		return 0, nil
+	}
+	if off >= i.info.Size {
+		return 0, io.EOF
+	}
+	for len(b) > 0 && off < i.info.Size {
+		page := off / spillPage
+		within := off % spillPage
+		take := min(int64(len(b)), spillPage-within, i.info.Size-off)
+		out := b[:take]
+		if r, ok := i.info.Spill.Pages[page]; ok {
+			clear(out)
+			if within < r.Bytes {
+				data, e := i.c.loadPage(ctx, i.info.Spill, r)
+				if e != nil {
+					return n, e
+				}
+				copy(out, data[within:])
+			}
+		} else if nr, e := fd.ReadAt(out, off); int64(nr) != take {
+			if e == nil {
+				e = io.ErrUnexpectedEOF
+			}
+			return n, e
+		}
+		n += int(take)
+		off += take
+		b = b[take:]
+	}
+	if len(b) > 0 {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+// The final destination is a regular object. At most one 4 MiB source page is
+// fetched at a time, including when the provider uses a multipart publisher.
+type spillStream struct {
+	i    *Item
+	ctx  context.Context
+	fd   *os.File
+	off  int64
+	page []byte
+	hash hash.Hash
+}
+
+func (r *spillStream) Read(out []byte) (int, error) {
+	if len(out) == 0 {
+		return 0, nil
+	}
+	if len(r.page) == 0 {
+		if r.off >= r.i.info.Size {
+			return 0, io.EOF
+		}
+		r.page = make([]byte, min(spillPage, r.i.info.Size-r.off))
+		n, e := r.i.readSpillAt(r.ctx, r.fd, r.page, r.off)
+		if e != nil || n != len(r.page) {
+			if e == nil {
+				e = io.ErrUnexpectedEOF
+			}
+			return 0, e
+		}
+	}
+	n := copy(out, r.page)
+	r.page = r.page[n:]
+	r.off += int64(n)
+	_, _ = r.hash.Write(out[:n])
+	return n, nil
+}
+func (i *Item) publishSpill(ctx context.Context, storeFn StoreFn) error {
+	if e := i.validSpill(); e != nil {
+		return e
+	}
+	if i.spillFault != nil {
+		return i.spillFault
+	}
+	if i.opens != 0 {
+		return errors.New("spill generation still open")
+	}
+	fd, e := os.Open(i.c.toOSPath(i.name))
+	if e != nil {
+		return e
+	}
+	defer fd.Close()
+	i.spillWorkers++
+	defer func() { i.spillWorkers-- }()
+	i.spillPublishing = make(chan struct{})
+	pending := i.spillPublishing
+	defer func() {
+		if i.spillPublishing == pending {
+			close(pending)
+			i.spillPublishing = nil
+		}
+	}()
+	s := i.info.Spill
+	name, size, mtime := i.name, i.info.Size, i.info.ModTime
+	snapshot := &Item{info: i.info, c: i.c}
+	reader := &spillStream{i: snapshot, ctx: ctx, fd: fd, hash: sha256.New()}
+	var published fs.Object
+	unlockMutexForCall(&i.mu, func() {
+		info := object.NewStaticObjectInfo(name, mtime, size, true, nil, i.c.fremote)
+		published, e = i.c.fremote.Put(ctx, reader, info)
+		if e != nil {
+			return
+		}
+		if published == nil || published.Size() != size || reader.off != size {
+			e = errors.New("incomplete writeback")
+			return
+		}
+		var got io.ReadCloser
+		got, e = published.Open(ctx)
+		if e != nil {
+			return
+		}
+		h := sha256.New()
+		var n int64
+		n, e = io.Copy(h, io.LimitReader(got, size+1))
+		ce := got.Close()
+		if e == nil {
+			e = ce
+		}
+		if e == nil && (n != size || !bytes.Equal(h.Sum(nil), reader.hash.Sum(nil))) {
+			e = errors.New("published writeback failed independent readback")
+		}
+	})
+	if e != nil {
+		return e
+	}
+	ticket, e := i.stageCleanup()
+	if e != nil {
+		return e
+	}
+	i.o = published
+	i._updateFingerprint()
+	i.info.Spill = nil
+	i.info.Dirty = false
+	if e = i.saveSpillInfo(); e != nil {
+		i.info.Spill = s
+		i.info.Dirty = true
+		return e
+	}
+	i.accountSpill(0)
+	if storeFn != nil {
+		unlockMutexForCall(&i.mu, func() { storeFn(published) })
+	}
+	// Readers may use the published destination while the private ticket drains.
+	close(pending)
+	i.spillPublishing = nil
+	unlockMutexForCall(&i.mu, func() {
+		if err := i.c.finishCleanup(ctx, ticket); err != nil {
+			fs.Errorf(name, "retained private writeback cleanup: %v", err)
+		}
+	})
+	return nil
+}
